---
import Footer from "../components/layout/Footer.astro"
import Header from "../components/layout/Header.astro"
import BaseLayout from "../layouts/BaseLayout.astro"

const orderFlow = [
  ["01", "Konsultasi kebutuhan", "Jumlah, fungsi pakaian, bahan, dan target waktu dibahas di awal."],
  ["02", "Formulir pesanan", "Rincian ukuran, warna, serta penempatan identitas dicatat."],
  ["03", "Penawaran", "Harga dan ruang lingkup pekerjaan dikirim untuk diperiksa."],
  ["04", "Pembayaran awal", "DP 60% menempatkan pesanan ke antrean kerja."],
  ["05", "Spesifikasi produksi", "Detail yang disepakati dirangkum sebagai acuan tim produksi."],
  ["06", "Desain dan persetujuan", "Visual serta detail akhir dikunci sebelum kain dipotong."],
  ["07", "Produksi", "Pemotongan, bordir, dan jahit berjalan sesuai spesifikasi."],
  ["08", "Pemeriksaan", "Ukuran, jumlah, jahitan, dan identitas diperiksa per batch."],
  ["09", "Pelunasan dan kirim", "Barang dikirim setelah hasil pemeriksaan dan pelunasan selesai."],
] as const
---

<BaseLayout
  title="Layanan & Portofolio Roller Customize"
  description="Dari konsultasi material, katalog workshirt, tabel ukuran, sampai proses produksi batch, Roller Customize menjaga seragam Anda tetap presisi."
  path="/layanan"
>
  <Header />
  <main id="main">
    <section class="service-hero" aria-labelledby="service-title">
      <p>Layanan & spesifikasi</p>
      <h1 id="service-title">Workshirt kustom, dengan rincian yang bisa diperiksa sebelum produksi.</h1>
      <div>Katalog di bawah memuat bahan, biaya, ukuran, dan urutan kerja yang kami gunakan.</div>
    </section>

    <!-- SECTION: PRODUCT CATALOG & PRICELIST -->
    <section class="catalog" aria-labelledby="catalog-title">
      <div class="catalog__inner">
        <div class="catalog__intro">
          <span class="catalog__tag">Katalog utama</span>
          <h2 id="catalog-title">Custom Workshirt</h2>
          <p class="catalog__moq"><strong>Pesanan minimum:</strong> 24 pcs <span class="catalog__moq-sub">Pesanan di bawah jumlah minimum dikenakan tambahan Rp15.000–Rp35.000 per pcs.</span></p>
          
          <div class="catalog__specs">
            <h3>Spesifikasi standar</h3>
            <ul>
              <li><strong>Model:</strong> Lengan Pendek</li>
              <li><strong>Desain:</strong> Termasuk 2 titik bordir komputer</li>
              <li><strong>Potongan:</strong> Reguler Cut</li>
              <li><strong>Ukuran Standar:</strong> S sampai XL</li>
            </ul>
          </div>

          <div class="catalog__notes">
            <h3>Ketentuan tambahan</h3>
            <ul>
              <li>Kenaikan ukuran di atas XL dikenakan tambahan +Rp5.000 per tingkat size (XXL, 3XL, dst).</li>
              <li>Bordir punggung ukuran besar (di atas 27 x 15 cm) dikenakan biaya sesuai dengan kerumitan desain.</li>
              <li>Aksen scotlight/reflector, velcro, dan kombinasi kain dihitung berdasarkan kerumitan produksi.</li>
              <li>Penggunaan resleting tambahan disesuaikan dengan merk yang diminta.</li>
            </ul>
          </div>
        </div>

        <div class="catalog__pricing-panel">
          <div class="pricing-card">
            <h3>Harga bahan utama</h3>
            <div class="pricing-list">
              <div class="pricing-item">
                <span>American Drill</span>
                <strong>Rp100.000 <small>/ pcs</small></strong>
              </div>
              <div class="pricing-item">
                <span>Nagata Drill</span>
                <strong>Rp120.000 <small>/ pcs</small></strong>
              </div>
              <div class="pricing-item">
                <span>Tropical</span>
                <strong>Rp145.000 <small>/ pcs</small></strong>
              </div>
              <div class="pricing-item">
                <span>Ripstop</span>
                <strong>Rp145.000 <small>/ pcs</small></strong>
              </div>
              <div class="pricing-item">
                <span>Bahan Lain (By Request)</span>
                <strong>Sesuai Material</strong>
              </div>
            </div>
          </div>

          <div class="variations-card">
            <h3>Variasi dan biaya tambahan</h3>
            <div class="variations-grid">
              <div class="var-item"><span>Up Size (&gt; XL)</span><strong>+Rp5.000</strong></div>
              <div class="var-item"><span>Boxy Cut</span><strong>+Rp7.000</strong></div>
              <div class="var-item"><span>Lengan Panjang</span><strong>+Rp10.000</strong></div>
              <div class="var-item"><span>Reflector / Scotlight</span><strong>Rp3.000 - Rp10.000</strong></div>
              <div class="var-item"><span>Velcro (Perekat)</span><strong>Rp3.000 - Rp10.000</strong></div>
              <div class="var-item"><span>Resleting Custom</span><strong>Rp7.000 - Rp20.000</strong></div>
              <div class="var-item"><span>Kombinasi Warna</span><strong>Rp5.000 - Rp20.000</strong></div>
              <div class="var-item"><span>Bordir Tambahan</span><strong>Rp5.000 - Rp30.000</strong></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="flow" aria-labelledby="flow-title">
      <div class="flow__panel">
        <div class="flow__hero">
          <span class="flow__tag">Prosedur kerja</span>
          <h2 id="flow-title">Dari percakapan pertama sampai barang dikirim.</h2>
          <p>Sembilan tahap, dengan keputusan yang jelas sebelum pekerjaan berpindah ke tahap berikutnya.</p>
        </div>
        <ol class="flow__list">
          {orderFlow.map(([number, title, description]) => (
            <li>
              <span>{number}</span>
              <div><strong>{title}</strong><p>{description}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SECTION: SIZE CHART TABS -->
    <section class="sizechart" aria-labelledby="sizechart-title">
      <div class="sizechart__inner">
        <div class="sizechart__header">
          <span class="sizechart__tag">Panduan Ukuran</span>
          <h2 id="sizechart-title">Panduan ukuran</h2>
          <p>Dua pola dasar yang dapat dipilih sebelum sampel dibuat.</p>
        </div>

        <div class="sizechart__tabs-container">
          <div class="tab-buttons" role="tablist">
            <button class="tab-button active" data-tab="reguler" role="tab" aria-selected="true">Pola Reguler Cut</button>
            <button class="tab-button" data-tab="boxy" role="tab" aria-selected="false">Pola Boxy Cut</button>
          </div>

          <div class="tab-panels">
            <!-- TAB 1: REGULER -->
            <div class="tab-panel active" id="reguler" role="tabpanel">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>68</td><td>50</td></tr>
                    <tr><td>M</td><td>70</td><td>52</td></tr>
                    <tr><td>L</td><td>72</td><td>54</td></tr>
                    <tr><td>XL</td><td>74</td><td>56</td></tr>
                    <tr><td>XXL</td><td>76</td><td>60</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- TAB 2: BOXY -->
            <div class="tab-panel" id="boxy" role="tabpanel">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>64</td><td>52</td></tr>
                    <tr><td>M</td><td>66</td><td>54</td></tr>
                    <tr><td>L</td><td>68</td><td>56</td></tr>
                    <tr><td>XL</td><td>70</td><td>58</td></tr>
                    <tr><td>XXL</td><td>72</td><td>60</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          
          <div class="sizechart__footer">
            <p>* Panduan ukuran di atas berlaku untuk produk <strong>Kemeja & Kaos</strong>.</p>
            <p>* Celana panjang, celana pendek, dan totebag menggunakan ukuran custom dari klien.</p>
            <p>* Pola ukuran kustom khusus dikenakan biaya tambahan dan dapat mempengaruhi durasi produksi.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: TERMS & CONDITIONS ACCORDION -->
    <section class="terms" aria-labelledby="terms-title">
      <div class="terms__inner">
        <div class="terms__header">
          <span class="terms__tag">Ketentuan kerja</span>
          <h2 id="terms-title">Sebelum pesanan dikunci</h2>
          <p>Waktu, toleransi produksi, pembayaran, dan pengiriman yang perlu disepakati.</p>
        </div>

        <div class="accordion">
          <details class="accordion__item">
            <summary>1. Waktu Produksi (Production Time)</summary>
            <div class="accordion__content">
              <p>Waktu produksi normal berkisar antara 14-20 hari kerja. Hitungan ini dimulai H+1 setelah desain final disetujui secara tertulis dan pembayaran DP minimal diterima. Hari Minggu serta hari libur nasional tidak dihitung sebagai hari kerja.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>2. Toleransi Ukuran (Size Tolerance)</summary>
            <div class="accordion__content">
              <p>Terdapat toleransi perbedaan ukuran sebesar ±1–2 cm dari size chart panduan yang digunakan. Hal ini wajar dalam standar produksi jahit konveksi massal.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>3. Akurasi Warna (Color Accuracy)</summary>
            <div class="accordion__content">
              <p>Akurasi warna produk akhir berkisar 90% dari referensi digital yang diberikan. Deviasi minor disebabkan oleh perbedaan lot celupan kain dari supplier, rendering tampilan layar gadget (RGB vs CMYK), serta faktor pencahayaan saat foto produksi.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>4. Desain & Persetujuan (Design & Approval)</summary>
            <div class="accordion__content">
              <p>Proses pemotongan kain hanya dilakukan setelah lembar persetujuan desain ditandatangani/disetujui klien. Segala bentuk revisi desain tidak dapat dilakukan apabila proses produksi jahit sudah berjalan. Kesalahan akibat kelalaian file desain dari klien menjadi tanggung jawab penuh pihak pembeli.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>5. Ketentuan Pembayaran (Payment Terms)</summary>
            <div class="accordion__content">
              <p>Produksi baru akan dimasukkan antrean jahit setelah pembayaran DP (Down Payment) minimal 60% lunas. Pelunasan tagihan sisa wajib ditransfer sebelum barang dikirim dari workshop. Pembayaran yang sudah masuk tidak dapat dikembalikan dengan alasan apa pun (non-refundable).</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>6. Keterlambatan Produksi (Production Delays)</summary>
            <div class="accordion__content">
              <p>Jika terjadi kendala teknis atau antrean bahan di pabrik supplier, tim kami akan menginformasikan keterlambatan tersebut kepada Anda selambat-lambatnya H-2 sebelum tenggat waktu pengiriman yang disepakati.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>7. Pengiriman (Shipping)</summary>
            <div class="accordion__content">
              <p>Barang dikirim segera setelah pelunasan tagihan terverifikasi. Biaya pengiriman ditanggung sepenuhnya oleh customer. Keterlambatan atau kerusakan akibat kelalaian pihak ekspedisi/kurir di luar tanggung jawab kami.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>8. Pemesanan Event (Event Order)</summary>
            <div class="accordion__content">
              <p>Untuk kebutuhan seragam yang akan dipakai pada tanggal event tertentu, kami sangat menyarankan pemesanan dilakukan selambat-lambatnya H-20 sebelum tanggal pemakaian demi menghindari resiko keterlambatan ekspedisi.</p>
            </div>
          </details>

          <details class="accordion__item">
            <summary>9. Klaim & Revisi (Claim & Revision)</summary>
            <div class="accordion__content">
              <p>Komplain kerusakan atau ketidaksesuaian pesanan hanya dilayani maksimal 2x24 jam setelah barang diterima di alamat tujuan. Klien wajib melampirkan bukti unboxing berupa foto/video jelas. Perbaikan/revisi gratis hanya berlaku jika kesalahan jahit murni berasal dari pihak produksi kami.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- SECTION: ASSURANCE (Existing Quality Control Section) -->
    <section class="assurance" aria-labelledby="assurance-title">
      <div>
        <p>Kontrol mutu</p>
        <h2 id="assurance-title">Pemeriksaan yang mengikuti ritme produksi, bukan menunggu di ujung.</h2>
      </div>
      <ol>
        <li><span>01</span><p>Material dan warna diverifikasi sebelum pemotongan berjalan.</p></li>
        <li><span>02</span><p>Ukuran dan pola diperiksa terhadap sampel yang telah disetujui.</p></li>
        <li><span>03</span><p>Batch akhir diperiksa kembali sebelum dipacking dan dikirim.</p></li>
      </ol>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  // Simple Tab Switcher logic for Size Chart
  document.querySelectorAll('.tab-button').forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-tab');
      
      // Update buttons active states
      document.querySelectorAll('.tab-button').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      button.classList.add('active');
      button.setAttribute('aria-selected', 'true');

      // Update panels active states
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      const activePanel = document.getElementById(tabId);
      if (activePanel) activePanel.classList.add('active');
    });
  });

</script>

<style>
  /* Base Layout Paddings */
  .catalog, .flow, .sizechart, .terms {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-20) var(--layout-edge);
  }

  .service-hero {
    border-bottom: var(--rule-width) solid var(--color-rule);
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-20) var(--layout-edge) var(--space-16);
  }

  .service-hero > p {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: 720;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-4);
    text-transform: uppercase;
  }

  .service-hero h1 {
    font-size: var(--type-h1);
    letter-spacing: -0.07em;
    line-height: 0.98;
    margin: 0;
    max-width: 17ch;
  }

  .service-hero > div {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    line-height: 1.55;
    margin-top: var(--space-8);
    max-width: 38rem;
  }

  /* Catalog / Specs & Pricelist */
  .catalog__inner {
    display: grid;
    gap: var(--space-12);
  }

  .catalog__tag, .flow__tag, .sizechart__tag, .terms__tag {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: 720;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-2);
  }

  .catalog__intro h2, .flow__header h2, .sizechart__header h2, .terms__header h2 {
    font-size: var(--type-h2);
    letter-spacing: -0.055em;
    line-height: 1.04;
    margin: 0 0 var(--space-4);
  }

  .catalog__moq {
    font-size: var(--type-lead);
    margin-bottom: var(--space-8);
  }

  .catalog__moq-sub {
    display: block;
    font-size: var(--type-small);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .catalog__specs, .catalog__notes {
    margin-top: var(--space-6);
    border-top: var(--rule-width) solid var(--color-rule);
    padding-top: var(--space-4);
  }

  .catalog__specs h3, .catalog__notes h3 {
    font-size: var(--type-h3);
    font-family: var(--font-display);
    margin: 0 0 var(--space-3);
  }

  .catalog__specs ul, .catalog__notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .catalog__specs li, .catalog__notes li {
    font-size: var(--type-body);
    position: relative;
    padding-left: var(--space-4);
  }

  .catalog__specs li::before, .catalog__notes li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  /* Pricing Panels */
  .catalog__pricing-panel {
    display: grid;
    gap: var(--space-8);
  }

  .pricing-card, .variations-card {
    border-top: var(--rule-width) solid var(--color-rule);
    padding-top: var(--space-5);
  }

  .pricing-card h3, .variations-card h3 {
    font-size: var(--type-h3);
    font-family: var(--font-display);
    margin: 0 0 var(--space-5);
    border-bottom: var(--rule-width) solid var(--color-rule);
    padding-bottom: var(--space-3);
  }

  .pricing-list {
    display: grid;
    gap: var(--space-4);
  }

  .pricing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--color-rule);
    padding-bottom: var(--space-2);
  }

  .pricing-item:last-child {
    border-bottom: 0;
  }

  .pricing-item span {
    font-weight: 650;
    font-size: var(--type-body);
  }

  .pricing-item strong {
    font-family: var(--font-display);
    font-size: var(--type-lead);
    color: var(--color-ink);
  }

  .pricing-item strong small {
    font-size: var(--type-label);
    font-weight: normal;
    color: var(--color-text-muted);
  }

  .variations-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }

  .var-item {
    display: grid;
    border-bottom: var(--rule-width) solid var(--color-rule);
    padding-block: var(--space-3);
  }

  .var-item span {
    font-size: var(--type-small);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .var-item strong {
    font-family: var(--font-display);
    font-size: var(--type-body);
    margin-top: var(--space-1);
  }

  .sizechart__header, .terms__header {
    max-width: 42rem;
    margin-bottom: var(--space-12);
  }

  .sizechart__header p, .terms__header p {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    margin-top: var(--space-2);
  }

  .flow {
    padding-block: 0;
  }

  .flow__panel {
    border-block: var(--rule-width) solid var(--color-rule);
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-16);
  }

  .flow__hero {
    max-width: 38rem;
  }

  .flow__tag {
    color: var(--color-signal);
    margin-bottom: var(--space-3);
  }

  .flow__hero h2 {
    font-size: var(--type-h2);
    letter-spacing: -0.055em;
    line-height: 1.04;
    margin: 0;
  }

  .flow__hero > p {
    color: var(--color-text-muted);
    margin-bottom: 0;
    margin-top: var(--space-4);
  }

  .flow__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flow__list li {
    border-top: var(--rule-width) solid var(--color-rule);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 2.5rem 1fr;
    padding-block: var(--space-5);
    position: relative;
  }

  .flow__list li:not(:last-child)::before {
    border-left: var(--rule-width) solid var(--color-signal);
    bottom: -0.55rem;
    content: "";
    height: 1.1rem;
    left: 0.55rem;
    position: absolute;
  }

  .flow__list li:not(:last-child)::after {
    border-bottom: var(--rule-width) solid var(--color-signal);
    border-right: var(--rule-width) solid var(--color-signal);
    bottom: -0.55rem;
    content: "";
    height: 0.4rem;
    left: 0.36rem;
    position: absolute;
    transform: rotate(45deg);
    width: 0.4rem;
  }

  .flow__list li > span {
    color: var(--color-signal);
    font-size: var(--type-small);
    font-weight: 720;
  }

  .flow__list strong {
    font-size: var(--type-h3);
  }

  .flow__list p {
    color: var(--color-text-muted);
    margin-bottom: 0;
    margin-top: var(--space-2);
  }

  /* Size Chart Sections */
  .sizechart__tabs-container {
    display: grid;
    gap: var(--space-6);
  }

  .tab-buttons {
    display: flex;
    gap: var(--space-3);
    border-bottom: var(--rule-width) solid var(--color-rule);
    padding-bottom: var(--space-2);
  }

  .tab-button {
    background: none;
    border: 0;
    color: var(--color-text-muted);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--type-body);
    font-weight: 800;
    padding: var(--space-2) var(--space-4);
    position: relative;
    transition: color var(--transition-micro);
  }

  .tab-button.active {
    color: var(--color-ink);
  }

  .tab-button.active::after {
    background: var(--color-signal);
    bottom: calc(var(--space-2) * -1 - 2px);
    content: "";
    height: 3px;
    left: 0;
    position: absolute;
    right: 0;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  /* Table styling */
  .table-wrapper {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    text-align: left;
  }

  th, td {
    border-bottom: var(--rule-width) solid var(--color-rule);
