---
import Footer from "../components/layout/Footer.astro"
import Header from "../components/layout/Header.astro"
import Button from "../components/ui/Button.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  title="Size Chart & Panduan Ukuran — Roller Customize"
  description="Panduan lengkap pola ukuran Reguler Cut dan Boxy Cut untuk Workshirt, Kemeja, Kaos, dan Jaket produksi Roller Customize."
  path="/size-chart"
>
  <Header />
  <main id="main">
    <section class="sizechart-hero" aria-labelledby="sizechart-hero-title">
      <div class="sizechart-hero__inner">
        <div class="sizechart-hero__meta">
          <span class="sizechart-hero__tag">Technical Sheet / 01</span>
          <span>RC—SIZE SYSTEM</span>
          <span>CM / ± 1–1.5</span>
        </div>
        <h1 id="sizechart-hero-title">Ukuran yang<br />tidak menerka.</h1>
        <p class="sizechart-hero__desc">
          Dua pola dasar untuk kebutuhan yang berbeda. <strong>Reguler</strong> menjaga proporsi kerja yang rapi; <strong>Boxy</strong> memberi volume yang lebih lepas dan pendek.
        </p>
      </div>
    </section>

    <!-- SECTION: SIZE CHART TABS -->
    <section class="sizechart" id="sizechart" aria-labelledby="sizechart-title">
      <div class="sizechart__inner">
        <div class="sizechart__tabs-container">
          <div class="tab-buttons" role="tablist" aria-label="Pilihan Pola Ukuran">
            <button class="tab-button active" data-tab="reguler" role="tab" aria-selected="true"><span>01</span>Pola Reguler</button>
            <button class="tab-button" data-tab="boxy" role="tab" aria-selected="false"><span>02</span>Pola Boxy</button>
          </div>

          <div class="tab-panels">
            <!-- TAB 1: REGULER -->
            <div class="tab-panel active" id="reguler" role="tabpanel">
              <div class="table-card">
                <div class="table-card__header">
                  <span>RC—REG / BASE 01</span>
                  <h3>Reguler Cut</h3>
                  <p>Pola potong standar konveksi yang memberikan ruang gerak nyaman, rapi, dan formal untuk aktivitas kerja sehari-hari.</p>
                </div>
                <div class="table-wrapper">
                  <table>
                    <thead>
                      <tr>
                        <th>Ukuran</th>
                        <th>Panjang Badan (cm)</th>
                        <th>Lebar Dada (cm)</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr><td>S</td><td>68</td><td>50</td></tr>
                      <tr><td>M</td><td>70</td><td>52</td></tr>
                      <tr><td>L</td><td>72</td><td>54</td></tr>
                      <tr><td>XL</td><td>74</td><td>56</td></tr>
                      <tr><td>XXL</td><td>76</td><td>60</td></tr>
                      <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- TAB 2: BOXY -->
            <div class="tab-panel" id="boxy" role="tabpanel">
              <div class="table-card">
                <div class="table-card__header">
                  <span>RC—BOXY / BASE 02</span>
                  <h3>Boxy Cut</h3>
                  <p>Pola potongan dengan lebar dada lebih luas dan panjang badan lebih pendek, memberikan tampilan kasual modern khas streetwear.</p>
                </div>
                <div class="table-wrapper">
                  <table>
                    <thead>
                      <tr>
                        <th>Ukuran</th>
                        <th>Panjang Badan (cm)</th>
                        <th>Lebar Dada (cm)</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr><td>S</td><td>64</td><td>52</td></tr>
                      <tr><td>M</td><td>66</td><td>54</td></tr>
                      <tr><td>L</td><td>68</td><td>56</td></tr>
                      <tr><td>XL</td><td>70</td><td>58</td></tr>
                      <tr><td>XXL</td><td>72</td><td>60</td></tr>
                      <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <div class="sizechart__notes">
            <h4>Catatan produksi</h4>
            <ul>
              <li>Panduan ukuran di atas berlaku standar untuk produk <strong>Workshirt, PDL/PDH, Workjacket, dan Kaos</strong>.</li>
              <li>Pola ukuran khusus (custom size chart per anggota tim) dapat diajukan saat tahap pengisian formulir pemesanan.</li>
              <li>Produk <strong>Celana Panjang, Celana Pendek, dan Totebag</strong> menggunakan spesifikasi ukuran custom dari customer.</li>
              <li>Toleransi perbedaan ukuran saat proses jahitan produksi adalah <strong>± 1–1.5 cm</strong>.</li>
            </ul>
          </div>

          <div class="sizechart__cta">
            <span>Fitting support / Yogyakarta</span>
            <h3>Ukuran tim tidak harus ditebak.</h3>
            <p>Kami dapat mendampingi fitting dan menyiapkan sampel fisik sebelum produksi massal.</p>
            <Button href="/kontak" label="Konsultasi Kebutuhan Ukuran" variant="signal" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .sizechart-hero {
    background: #a79a8a;
    color: #1a1a1a;
    padding: var(--space-8) var(--layout-edge) var(--space-20);
  }

  .sizechart-hero__inner {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1.8fr) minmax(18rem, 0.6fr);
    margin: 0 auto;
    max-width: var(--layout-max);
  }

  .sizechart-hero__meta {
    border-bottom: 1px solid #6f6257;
    display: flex;
    font-size: 0.66rem;
    font-weight: var(--font-weight-bold);
    grid-column: 1 / -1;
    justify-content: space-between;
    letter-spacing: 0.1em;
    padding-bottom: var(--space-3);
    text-transform: uppercase;
  }

  .sizechart-hero__tag {
    color: #1a1a1a;
  }

  .sizechart-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8.5vw, 8rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.08em;
    line-height: 0.84;
    margin: 0;
  }

  .sizechart-hero__desc {
    align-self: end;
    border-top: 1px solid #6f6257;
    color: #3d352e;
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
    padding-top: var(--space-4);
  }

  .sizechart {
    background: #3d352e !important;
    color: #f7f3ee !important;
    padding: var(--space-10) var(--layout-edge) var(--space-24);
  }

  .sizechart__inner {
    margin: 0 auto;
    max-width: var(--layout-max);
  }

  .tab-buttons {
    display: flex;
    gap: 0;
    border-bottom: 1px solid rgba(216, 207, 196, 0.42);
    margin-bottom: var(--space-12);
  }

  .tab-button {
    align-items: center;
    background: transparent;
    border: 0;
    border-right: 1px solid rgba(216, 207, 196, 0.42);
    color: #a79a8a;
    cursor: pointer;
    display: flex;
    flex: 1;
    font-size: clamp(1.2rem, 2.5vw, 2.2rem);
    font-weight: var(--font-weight-bold);
    gap: var(--space-4);
    justify-content: flex-start;
    padding: var(--space-5) var(--space-6);
    text-align: left;
    transition: background-color var(--transition-micro), color var(--transition-micro);
  }

  .tab-button:first-child {
    border-left: 1px solid rgba(216, 207, 196, 0.42);
  }

  .tab-button span {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .tab-button:hover {
    color: #f7f3ee;
  }

  .tab-button.active {
    background: #d8cfc4;
    color: #1a1a1a;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  .table-card {
    background: transparent;
    border: 0;
    padding: 0;
  }

  .table-card__header {
    align-items: end;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 0.45fr 1fr 0.85fr;
    margin-bottom: var(--space-10);
  }

  .table-card__header > span {
    align-self: start;
    color: #a79a8a;
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
  }

  .table-card__header h3 {
    color: #f7f3ee;
    font-size: clamp(3.2rem, 7vw, 6.6rem);
    letter-spacing: -0.075em;
    line-height: 0.86;
    margin: 0;
  }

  .table-card__header p {
    border-top: 1px solid rgba(216, 207, 196, 0.42);
    color: #d8cfc4;
    font-size: var(--type-small);
    margin: 0;
    padding-top: var(--space-3);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    border-top: 2px solid #f7f3ee;
    width: 100%;
    text-align: left;
  }

  th, td {
    border-bottom: 1px solid rgba(216, 207, 196, 0.42);
    padding: var(--space-5) var(--space-2);
  }

  th {
    background: transparent;
    color: #a79a8a;
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td {
    color: #f7f3ee;
    font-size: clamp(1.15rem, 2vw, 1.8rem);
    font-variant-numeric: tabular-nums;
  }

  td:first-child {
    font-size: clamp(1.7rem, 3vw, 2.8rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
  }

  .table-add {
    background: color-mix(in srgb, #d8cfc4 12%, #3d352e);
    font-weight: var(--font-weight-bold);
  }

  .sizechart__notes {
    border-bottom: 1px solid rgba(216, 207, 196, 0.42);
    border-top: 1px solid rgba(216, 207, 196, 0.42);
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 0.45fr 1.85fr;
    margin-top: var(--space-16);
    padding: var(--space-6) 0;
  }

  .sizechart__notes h4 {
    color: #f7f3ee;
    font-size: var(--type-body);
    margin: 0;
  }

  .sizechart__notes ul {
    margin: 0;
    padding: 0;
    color: #d8cfc4;
    display: grid;
    gap: 0;
    font-size: var(--type-small);
    list-style: none;
  }

  .sizechart__notes li {
    border-top: 1px solid rgba(216, 207, 196, 0.22);
    padding: var(--space-3) 0;
  }

  .sizechart__notes li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .sizechart__cta {
    align-items: end;
    background: #d8cfc4;
    color: #1a1a1a;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 0.45fr 1fr 0.85fr auto;
    margin-top: var(--space-16);
    padding: var(--space-8);
    text-align: left;
  }

  .sizechart__cta > span {
    align-self: start;
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sizechart__cta h3 {
    font-size: clamp(2rem, 4vw, 3.8rem);
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 0;
  }

  .sizechart__cta p {
    color: #3d352e;
    margin: 0;
    max-width: 24rem;
    font-size: var(--type-small);
  }

  .sizechart__cta :global(.button) {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: #f7f3ee;
  }

  @media (max-width: 48rem) {
    .sizechart-hero {
      padding: var(--space-6) var(--layout-edge) var(--space-12);
    }

    .sizechart-hero__inner,
    .table-card__header,
    .sizechart__notes,
    .sizechart__cta {
      grid-template-columns: 1fr;
    }

    .sizechart-hero__meta span:nth-child(2) {
      display: none;
    }

    .sizechart-hero h1 {
      font-size: clamp(3.8rem, 17vw, 5.2rem);
    }

    .sizechart {
      padding: var(--space-8) var(--layout-edge) var(--space-16);
    }

    .tab-button {
      align-items: flex-start;
      flex-direction: column;
      font-size: 1.05rem;
      gap: var(--space-2);
      padding: var(--space-4);
    }

    .table-card__header {
      gap: var(--space-4);
      margin-bottom: var(--space-8);
    }

    th, td {
      padding: var(--space-4) var(--space-2);
    }

    th {
      font-size: 0.58rem;
      line-height: 1.35;
    }

    .sizechart__notes,
    .sizechart__cta {
      gap: var(--space-5);
      margin-top: var(--space-12);
    }

    .sizechart__cta {
      padding: var(--space-6);
    }

    .sizechart__cta :global(.button) {
      width: 100%;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const tabButtons = document.querySelectorAll(".tab-button");
    const tabPanels = document.querySelectorAll(".tab-panel");

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.getAttribute("data-tab");

        tabButtons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });

        tabPanels.forEach((p) => {
          p.classList.remove("active");
        });

        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");

        const targetPanel = document.getElementById(targetTab);
        if (targetPanel) {
          targetPanel.classList.add("active");
        }
      });
    });
  });
</script>
