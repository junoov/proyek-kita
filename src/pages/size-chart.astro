---
import Footer from "../components/layout/Footer.astro"
import Header from "../components/layout/Header.astro"
import PageHero from "../components/sections/PageHero.astro"
import Button from "../components/ui/Button.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  title="Size Chart & Panduan Ukuran — Roller Customize"
  description="Panduan lengkap pola ukuran Reguler Cut dan Boxy Cut untuk Workshirt, Kemeja, Kaos, dan Jaket produksi Roller Customize."
  path="/size-chart"
>
  <Header />
  <main id="main">
    <section class="sizechart-hero" aria-labelledby="sizechart-hero-title">
      <div class="sizechart-hero__inner">
        <span class="sizechart-hero__tag">Panduan Ukuran</span>
        <h1 id="sizechart-hero-title">Size Chart & Pola Potongan Seragam</h1>
        <p class="sizechart-hero__desc">
          Pilih acuan pola potongan yang paling sesuai dengan kebutuhan tim Anda. Kami menyediakan standar pola <strong>Reguler Cut</strong> dan <strong>Boxy Cut</strong>.
        </p>
      </div>
    </section>

    <!-- SECTION: SIZE CHART CONTAINER (DARK BROWN FULL BLEED) -->
    <section class="sizechart" id="sizechart" aria-labelledby="sizechart-title">
      <div class="sizechart__inner">

        <div class="product-cards-container">

          <!-- 1. KEMEJA (WORKSHIRT / PDL / PDH) -->
          <div class="product-card" id="kemeja">
            <div class="product-card__header">
              <div class="product-card__title-group">
                <h3>Kemeja (Workshirt, PDL/PDH)</h3>
                <p>Pola potong konveksi rapi dan nyaman untuk aktivitas kerja sehari-hari.</p>
              </div>
              <div class="fit-tabs" role="tablist" data-card="kemeja">
                <button class="fit-tab active" data-fit="reguler" role="tab" aria-selected="true">Reguler</button>
                <button class="fit-tab" data-fit="boxy" role="tab" aria-selected="false">Boxy</button>
              </div>
            </div>
            
            <div class="fit-content active" data-fit-content="reguler">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                      <th>Panjang Lengan (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>68</td><td>50</td><td>23</td></tr>
                    <tr><td>M</td><td>70</td><td>52</td><td>24</td></tr>
                    <tr><td>L</td><td>72</td><td>54</td><td>25</td></tr>
                    <tr><td>XL</td><td>74</td><td>56</td><td>26</td></tr>
                    <tr><td>XXL</td><td>76</td><td>60</td><td>27</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td><td>+1</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="fit-content" data-fit-content="boxy">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                      <th>Panjang Lengan (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>64</td><td>54</td><td>22</td></tr>
                    <tr><td>M</td><td>66</td><td>56</td><td>23</td></tr>
                    <tr><td>L</td><td>68</td><td>58</td><td>24</td></tr>
                    <tr><td>XL</td><td>70</td><td>60</td><td>25</td></tr>
                    <tr><td>XXL</td><td>72</td><td>62</td><td>26</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td><td>+1</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 2. T-SHIRT (KAOS) -->
          <div class="product-card" id="t-shirt">
            <div class="product-card__header">
              <div class="product-card__title-group">
                <h3>T-Shirt (Kaos Custom)</h3>
                <p>Kaos katun berkualitas dengan standar potongan Reguler & Boxy streetwear.</p>
              </div>
              <div class="fit-tabs" role="tablist" data-card="t-shirt">
                <button class="fit-tab active" data-fit="reguler" role="tab" aria-selected="true">Reguler</button>
                <button class="fit-tab" data-fit="boxy" role="tab" aria-selected="false">Boxy</button>
              </div>
            </div>

            <div class="fit-content active" data-fit-content="reguler">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                      <th>Panjang Lengan (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>68</td><td>48</td><td>20</td></tr>
                    <tr><td>M</td><td>70</td><td>50</td><td>21</td></tr>
                    <tr><td>L</td><td>72</td><td>52</td><td>22</td></tr>
                    <tr><td>XL</td><td>74</td><td>54</td><td>23</td></tr>
                    <tr><td>XXL</td><td>76</td><td>58</td><td>24</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td><td>+1</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="fit-content" data-fit-content="boxy">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                      <th>Panjang Lengan (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>64</td><td>54</td><td>21</td></tr>
                    <tr><td>M</td><td>66</td><td>56</td><td>22</td></tr>
                    <tr><td>L</td><td>68</td><td>58</td><td>23</td></tr>
                    <tr><td>XL</td><td>70</td><td>60</td><td>24</td></tr>
                    <tr><td>XXL</td><td>72</td><td>62</td><td>25</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td><td>+1</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 3. WORKJACKET -->
          <div class="product-card" id="workjacket">
            <div class="product-card__header">
              <div class="product-card__title-group">
                <h3>Workjacket (Jaket Kerja)</h3>
                <p>Outerwear kokoh dengan siluet lapang dan proporsional untuk lapangan.</p>
              </div>
              <div class="fit-tabs">
                <span class="fit-tag">Standard Fit</span>
              </div>
            </div>

            <div class="fit-content active">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                      <th>Panjang Lengan (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>66</td><td>54</td><td>58</td></tr>
                    <tr><td>M</td><td>68</td><td>56</td><td>60</td></tr>
                    <tr><td>L</td><td>70</td><td>58</td><td>62</td></tr>
                    <tr><td>XL</td><td>72</td><td>60</td><td>64</td></tr>
                    <tr><td>XXL</td><td>74</td><td>64</td><td>66</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td><td>+2</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 4. VEST -->
          <div class="product-card" id="vest">
            <div class="product-card__header">
              <div class="product-card__title-group">
                <h3>Vest (Rompi Kerja)</h3>
                <p>Rompi taktis dan kerja serbaguna dengan ukuran bahu presisi.</p>
              </div>
              <div class="fit-tabs">
                <span class="fit-tag">Standard Fit</span>
              </div>
            </div>

            <div class="fit-content active">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran</th>
                      <th>Panjang Badan (cm)</th>
                      <th>Lebar Dada (cm)</th>
                      <th>Lebar Bahu (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>62</td><td>52</td><td>40</td></tr>
                    <tr><td>M</td><td>64</td><td>54</td><td>42</td></tr>
                    <tr><td>L</td><td>66</td><td>56</td><td>44</td></tr>
                    <tr><td>XL</td><td>68</td><td>58</td><td>46</td></tr>
                    <tr><td>XXL</td><td>70</td><td>62</td><td>48</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+2</td><td>+2</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 5. CELANA -->
          <div class="product-card" id="celana">
            <div class="product-card__header">
              <div class="product-card__title-group">
                <h3>Celana (Panjang & Pendek)</h3>
                <p>Celana workwear, PDL, dan casual dengan pinggang fleksibel.</p>
              </div>
              <div class="fit-tabs" role="tablist" data-card="celana">
                <button class="fit-tab active" data-fit="panjang" role="tab" aria-selected="true">Panjang</button>
                <button class="fit-tab" data-fit="pendek" role="tab" aria-selected="false">Pendek</button>
              </div>
            </div>

            <div class="fit-content active" data-fit-content="panjang">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran (Pinggang)</th>
                      <th>Panjang Celana (cm)</th>
                      <th>Lingkar Pinggang (cm)</th>
                      <th>Lingkar Paha (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S (28–29)</td><td>98</td><td>76</td><td>58</td></tr>
                    <tr><td>M (30–31)</td><td>100</td><td>81</td><td>60</td></tr>
                    <tr><td>L (32–33)</td><td>102</td><td>86</td><td>62</td></tr>
                    <tr><td>XL (34–35)</td><td>104</td><td>91</td><td>64</td></tr>
                    <tr><td>XXL (36–37)</td><td>106</td><td>96</td><td>68</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+5</td><td>+2</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="fit-content" data-fit-content="pendek">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Ukuran (Pinggang)</th>
                      <th>Panjang Celana (cm)</th>
                      <th>Lingkar Pinggang (cm)</th>
                      <th>Lingkar Paha (cm)</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>S (28–29)</td><td>45</td><td>76</td><td>58</td></tr>
                    <tr><td>M (30–31)</td><td>47</td><td>81</td><td>60</td></tr>
                    <tr><td>L (32–33)</td><td>49</td><td>86</td><td>62</td></tr>
                    <tr><td>XL (34–35)</td><td>51</td><td>91</td><td>64</td></tr>
                    <tr><td>XXL (36–37)</td><td>53</td><td>96</td><td>68</td></tr>
                    <tr class="table-add"><td>Per kenaikan size (+X)</td><td>+2</td><td>+5</td><td>+2</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 6. TOTEBAG & APRON -->
          <div class="product-card" id="totebag-apron">
            <div class="product-card__header">
              <div class="product-card__title-group">
                <h3>Totebag & Apron</h3>
                <p>Spesifikasi dimensi aksesoris dan atribut pendukung kerja.</p>
              </div>
              <div class="fit-tabs">
                <span class="fit-tag">Standard Specs</span>
              </div>
            </div>

            <div class="fit-content active">
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th>Produk</th>
                      <th>Panjang / Tinggi (cm)</th>
                      <th>Lebar (cm)</th>
                      <th>Spesifikasi Tali / Fitur</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>Totebag Standard</td><td>40</td><td>35</td><td>Tali 60 cm (Panjang Bahu)</td></tr>
                    <tr><td>Apron / Celemek</td><td>75</td><td>65</td><td>Tali Leher & Pinggang Adjustable</td></tr>
                    <tr class="table-add"><td>Custom Dimensions</td><td colspan="3">Ukuran custom dapat disesuaikan dengan kebutuhan produksi Anda</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>

        <div class="sizechart__notes">
          <h4>Catatan Tambahan Mengenai Ukuran:</h4>
          <ul>
            <li>Panduan ukuran di atas berlaku standar untuk produk <strong>Workshirt, PDL/PDH, Workjacket, dan Kaos</strong>.</li>
            <li>Pola ukuran khusus (custom size chart per anggota tim) dapat diajukan saat tahap pengisian formulir pemesanan.</li>
            <li>Produk <strong>Celana Panjang, Celana Pendek, dan Totebag</strong> menggunakan spesifikasi ukuran custom dari customer.</li>
            <li>Toleransi perbedaan ukuran saat proses jahitan produksi adalah <strong>± 1–1.5 cm</strong>.</li>
          </ul>
        </div>

        <div class="sizechart__cta">
          <h3>Diskusikan kebutuhan ukuran tim Anda bersama kami.</h3>
          <Button href="/kontak" label="Konsultasi Kebutuhan Ukuran" variant="signal" />
        </div>

      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .sizechart-hero {
    position: relative;
    background-color: var(--color-mist);
    background-image: linear-gradient(
        90deg,
        rgba(216, 207, 196, 0.88) 0%,
        rgba(216, 207, 196, 0.65) 45%,
        rgba(216, 207, 196, 0.20) 100%
      ),
      url("/size-chart-hero.jpg");
    background-size: cover;
    background-position: center right;
    color: var(--color-ink);
    padding: var(--space-16) var(--layout-edge) var(--space-16);
  }

  @media (max-width: 47.99rem) {
    .sizechart-hero {
      background-image: linear-gradient(
          180deg,
          rgba(216, 207, 196, 0.90) 0%,
          rgba(216, 207, 196, 0.55) 100%
        ),
        url("/size-chart-hero.jpg");
    }
  }

  .sizechart-hero__inner {
    margin: 0 auto;
    max-width: var(--layout-max);
    position: relative;
    z-index: 2;
  }

  .sizechart-hero__tag {
    color: var(--color-signal);
    display: block;
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
    text-transform: uppercase;
  }

  .sizechart-hero h1 {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 var(--space-4);
  }

  .sizechart-hero__desc {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    font-weight: var(--font-weight-medium);
    line-height: 1.6;
    max-width: 42rem;
    margin: 0;
  }

  /* SECTION FULL BLEED BACKGROUND #3D352E */
  .sizechart {
    background-color: #3d352e;
    color: #f7f3ee;
    padding: var(--space-16) var(--layout-edge) var(--space-24);
  }

  .sizechart__inner {
    margin: 0 auto;
    max-width: var(--layout-max);
  }

  .product-cards-container {
    display: grid;
    gap: var(--space-8);
  }

  /* PRODUCT CARD MATCHING USER SCREENSHOT: SAND CONTAINER #D8CFC4 */
  .product-card {
    background-color: #d8cfc4;
    color: #1a1a1a !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    padding: var(--space-6) var(--space-8);
    border-radius: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .product-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .product-card__title-group h3 {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 700 !important;
    margin: 0 0 var(--space-1);
    color: #1a1a1a !important;
    letter-spacing: -0.02em;
  }

  .product-card__title-group p {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: var(--type-small);
    color: #3d352e !important;
    margin: 0;
  }

  /* FIT SUB-TABS ON TOP-RIGHT OF CARD HEADER */
  .fit-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(61, 53, 46, 0.15);
    padding: 3px;
    border-radius: 0;
  }

  .fit-tab {
    background: transparent;
    border: none;
    color: #3d352e !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: 0.85rem;
    font-weight: 700 !important;
    padding: 0.35rem 0.85rem;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .fit-tab:hover {
    color: #1a1a1a !important;
  }

  .fit-tab.active {
    background: #3d352e !important;
    color: #f7f3ee !important;
    font-weight: 700 !important;
  }

  .fit-tag {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: 0.75rem;
    font-weight: 700 !important;
    color: #f7f3ee !important;
    background: #3d352e !important;
    padding: 0.35rem 0.75rem;
    border-radius: 0;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fit-content {
    display: none;
  }

  .fit-content.active {
    display: block;
  }

  .table-wrapper {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    text-align: left;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  }

  th, td {
    padding: var(--space-4) var(--space-5);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  }

  th {
    background-color: #3d352e !important;
    color: #f7f3ee !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: var(--type-label);
    font-weight: 700 !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td {
    color: #1a1a1a !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    border-bottom: 1px solid rgba(61, 53, 46, 0.25);
    font-variant-numeric: tabular-nums;
  }

  td:first-child {
    font-size: var(--type-body);
    font-weight: 700 !important;
    color: #1a1a1a !important;
  }

  .table-add {
    background: rgba(61, 53, 46, 0.08);
  }

  .table-add td {
    font-size: 0.95rem;
    font-weight: 700 !important;
    color: #3d352e !important;
  }

  /* NOTES & CTA BOXES MATCHING USER SCREENSHOT */
  .sizechart__notes {
    background-color: #4b433c;
    color: #f7f3ee !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    padding: var(--space-6) var(--space-8);
    margin-top: var(--space-12);
    border-radius: 0;
  }

  .sizechart__notes h4 {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: var(--type-body);
    font-weight: 700 !important;
    margin: 0 0 var(--space-4);
    color: #f7f3ee !important;
  }

  .sizechart__notes ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: #d8cfc4 !important;
    display: grid;
    gap: var(--space-3);
    font-size: var(--type-small);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  }

  .sizechart__notes li {
    position: relative;
    padding-left: var(--space-4);
    line-height: 1.5;
    color: #d8cfc4 !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  }

  .sizechart__notes li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #d8cfc4;
  }

  .sizechart__notes strong {
    color: #f7f3ee !important;
    font-weight: 700 !important;
  }

  .sizechart__cta {
    background-color: #d8cfc4;
    color: #1a1a1a !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    border-radius: 0;
    text-align: center;
    padding: var(--space-8) var(--space-8);
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .sizechart__cta h3 {
    margin: 0;
    color: #1a1a1a !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 700 !important;
  }

  .sizechart__cta :global(.button) {
    width: 100%;
    max-width: 100%;
    background: #3d352e !important;
    border-color: #3d352e !important;
    color: #f7f3ee !important;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    font-weight: 700 !important;
    min-height: 3rem;
    border-radius: 0;
    transition: background-color var(--transition-micro), border-color var(--transition-micro), color var(--transition-micro);
  }

  .sizechart__cta :global(.button:hover),
  .sizechart__cta :global(.button:focus),
  .sizechart__cta :global(.button:active) {
    background: #d8cfc4 !important;
    border-color: #3d352e !important;
    color: #3d352e !important;
    font-weight: 700 !important;
  }

  @media (max-width: 48rem) {
    .sizechart-hero {
      padding: var(--space-6) var(--layout-edge) var(--space-12);
    }

    .product-card {
      padding: var(--space-4);
    }

    .product-card__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .fit-tabs {
      width: 100%;
    }

    .fit-tab {
      flex: 1;
      text-align: center;
    }

    th, td {
      padding: var(--space-3) var(--space-2);
      font-size: 0.9rem;
    }

    th {
      font-size: 0.65rem;
    }

    .sizechart__cta {
      padding: var(--space-6);
    }

    .sizechart__cta :global(.button) {
      width: 100%;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Sub-tabs switching per card (Regular vs Boxy / Panjang vs Pendek)
    const fitTabContainers = document.querySelectorAll(".fit-tabs[data-card]");

    fitTabContainers.forEach((container) => {
      const card = container.closest(".product-card");
      if (!card) return;

      const tabs = container.querySelectorAll(".fit-tab");
      const contents = card.querySelectorAll(".fit-content");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const targetFit = tab.getAttribute("data-fit");

          tabs.forEach((t) => {
            t.classList.remove("active");
            t.setAttribute("aria-selected", "false");
          });

          contents.forEach((c) => {
            c.classList.remove("active");
          });

          tab.classList.add("active");
          tab.setAttribute("aria-selected", "true");

          const targetContent = card.querySelector(`.fit-content[data-fit-content="${targetFit}"]`);
          if (targetContent) {
            targetContent.classList.add("active");
          }
        });
      });
    });
  });
</script>
