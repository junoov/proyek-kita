---
import Footer from "../components/layout/Footer.astro"
import Header from "../components/layout/Header.astro"
import Gallery from "../components/sections/Gallery.astro"
import ContactCTA from "../components/sections/ContactCTA.astro"
import PageHero from "../components/sections/PageHero.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  title="Pelanggan Roller Customize"
  description="Roller Customize mendukung kebutuhan seragam kerja untuk korporat, komunitas, instansi, dan organisasi."
  path="/pelanggan"
>
  <Header />
  <main id="main">
    <PageHero
      label="Pelanggan"
      title="Dari seragam korporat hingga seragam komunitas, kami menyesuaikan setiap spesifikasi produksi dengan kebutuhan Anda."
    />
    <Gallery />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>

<style>
  main :global(.page-hero h1) {
    max-width: 27ch;
  }
</style>
