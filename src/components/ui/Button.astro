---
type Variant = "signal" | "ink" | "quiet"

type Props = {
  readonly href: string
  readonly label: string
  readonly variant?: Variant
}

const { href, label, variant = "signal" } = Astro.props
---

<a class={`button button--${variant}`} href={href}>
  <span>{label}</span>
</a>

<style>
  .button {
    align-items: center;
    border: var(--rule-width) solid currentColor;
    display: inline-flex;
    font-size: var(--type-small);
    font-weight: 720;
    justify-content: center;
    min-height: var(--space-12);
    padding: var(--space-3) var(--space-4);
    transition:
      background-color var(--transition-micro),
      border-color var(--transition-micro),
      color var(--transition-micro);
    white-space: nowrap;
  }

  .button:hover {
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .button--signal {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: var(--color-text-inverse);
  }

  .button--signal:hover {
    background: transparent;
    border-color: var(--color-ink);
  }

  .button--ink {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-text-inverse);
  }

  .button--quiet {
    color: inherit;
    opacity: 0.8;
  }

  .button--quiet:hover {
    border-color: currentColor;
    opacity: 1;
  }
</style>
