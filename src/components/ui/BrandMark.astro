---
type Props = {
  readonly inverted?: boolean
  readonly size?: "sm" | "md" | "lg"
}

const { inverted = false, size = "md" } = Astro.props
const className = [
  "brand-mark",
  inverted && "brand-mark--inverse",
  size && `brand-mark--${size}`,
].filter(Boolean).join(" ")
---

<span class={className} aria-label="Roller Customize">
  <svg class="brand-mark__glyph" viewBox="0 0 100 100" aria-hidden="true" fill="currentColor">
    <rect x="41" y="0" width="18" height="100" />
    <rect x="41" y="0" width="18" height="100" transform="rotate(60 50 50)" />
    <rect x="41" y="0" width="18" height="100" transform="rotate(120 50 50)" />
  </svg>
  <span class="brand-mark__copy">
    <span>Roller</span>
    <span>Customize</span>
  </span>
</span>

<style>
  .brand-mark {
    align-items: center;
    color: var(--color-text);
    display: inline-flex;
    gap: 0.5rem;
    line-height: 1;
    text-decoration: none;
  }

  .brand-mark__glyph {
    display: block;
    height: 1.875rem;
    width: 1.875rem;
    flex-shrink: 0;
  }

  .brand-mark__copy {
    display: grid;
    font-size: 0.9rem;
    gap: 0;
    letter-spacing: 0.04em;
    line-height: 1.02;
  }

  .brand-mark__copy span {
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .brand-mark--inverse {
    color: var(--color-text-inverse);
  }

  .brand-mark--sm .brand-mark__glyph {
    height: 1.5rem;
    width: 1.5rem;
  }
  .brand-mark--sm .brand-mark__copy {
    font-size: 0.775rem;
  }

  .brand-mark--lg .brand-mark__glyph {
    height: 2.5rem;
    width: 2.5rem;
  }
  .brand-mark--lg .brand-mark__copy {
    font-size: 1.2rem;
  }
</style>

