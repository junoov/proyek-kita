---
type Props = {
  readonly inverted?: boolean
  readonly size?: "sm" | "md" | "lg"
}

const { inverted = false, size = "md" } = Astro.props
const className = [
  "brand-mark",
  inverted && "brand-mark--inverse",
  size && `brand-mark--${size}`,
].filter(Boolean).join(" ")
---

<span class={className} aria-label="Roller Customize">
  <svg class="brand-mark__glyph" viewBox="0 0 100 100" aria-hidden="true" fill="currentColor">
    <rect x="41" y="0" width="18" height="100" />
    <rect x="41" y="0" width="18" height="100" transform="rotate(60 50 50)" />
    <rect x="41" y="0" width="18" height="100" transform="rotate(120 50 50)" />
  </svg>
  <span class="brand-mark__copy">
    <span>Roller</span>
    <span>Customize</span>
  </span>
</span>

<style>
  .brand-mark {
    --mark-size: 1.65rem;
    --mark-font: 0.88rem;
    align-items: center;
    color: var(--color-text);
    display: inline-flex;
    gap: 0.4rem;
    line-height: 1;
    text-decoration: none;
  }

  .brand-mark--sm {
    --mark-size: 1.35rem;
    --mark-font: 0.72rem;
  }

  .brand-mark--lg {
    --mark-size: 2.2rem;
    --mark-font: 1.15rem;
  }

  .brand-mark__glyph {
    display: block;
    height: var(--mark-size);
    width: var(--mark-size);
    flex-shrink: 0;
  }

  .brand-mark__copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: var(--mark-size);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: var(--mark-font);
    letter-spacing: 0.02em;
    line-height: 0.82;
  }

  .brand-mark__copy span {
    display: block;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .brand-mark__copy span:first-child {
    margin-top: -0.05em;
  }

  .brand-mark__copy span:last-child {
    margin-bottom: -0.11em;
  }

  .brand-mark--inverse {
    color: var(--color-text-inverse);
  }
</style>
