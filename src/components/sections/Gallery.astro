---
import galleryData from "../../data/gallery.json"

type Props = {
  readonly category?: "home" | "pelanggan"
}

const { category = "home" } = Astro.props
const initialItems = (galleryData.items || galleryData).filter((item) => item.image !== "/hero/hero.jpg")
---

<section class="gallery" data-category={category} aria-labelledby="gallery-title">
  <div class="gallery__header">
    <span class="gallery__tag">Our Product</span>
    <h2 id="gallery-title">Our Product</h2>
    <p>Koleksi produksi seragam dan workwear yang telah kami hasilkan.</p>
  </div>

  <div class="gallery__grid" id="gallery-grid">
    {initialItems.map((item, i) => (
      <button
        class="gallery__item"
        data-index={i}
        data-src={item.image}
        data-title={item.title || `Foto produk ${i + 1}`}
        aria-label={`Buka foto produk ${i + 1}`}
      >
        <img
          src={item.image}
          alt={item.title || `Foto produk Roller Customize ${i + 1}`}
          loading="lazy"
          decoding="async"
          width="600"
          height="800"
        />
        <span class="gallery__caption">{item.title || `Foto produk ${i + 1}`}</span>
      </button>
    ))}
  </div>

  <div class="gallery__action">
    <a
      href="https://drive.google.com/drive/folders/1dd4eTaFRED5yIjjGizIdjR4pCpfgTphp"
      target="_blank"
      rel="noopener noreferrer"
      class="button button--signal gallery__drive-btn"
    >
      <span>Pricelist</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>


  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Lightbox foto" hidden>
    <button class="lightbox__close" id="lightbox-close" aria-label="Tutup lightbox">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <button class="lightbox__prev" id="lightbox-prev" aria-label="Foto sebelumnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lightbox__next" id="lightbox-next" aria-label="Foto berikutnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lightbox__img-wrap">
      <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox__counter" id="lightbox-counter">1 / 15</div>
  </div>
</section>

<style>
  .gallery {
    background-color: #3d352e;
    color: #f7f3ee;
    --color-text: #f7f3ee;
    --color-text-muted: #d8cfc4;
    --color-signal: #d8cfc4;
    width: 100%;
    margin: 0;
    padding: var(--space-20) var(--layout-edge) var(--space-16);
  }

  .gallery__header,
  .gallery__grid,
  .gallery__action {
    margin-left: auto;
    margin-right: auto;
    max-width: var(--layout-max);
  }

  .gallery__header {
    margin-bottom: var(--space-12);
  }

  .gallery__tag {
    display: inline-block;
    color: #d8cfc4;
    font-size: var(--type-label);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .gallery__header h2 {
    color: #f7f3ee;
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 var(--space-4);
  }

  .gallery__header p {
    color: #d8cfc4;
    font-size: var(--type-lead);
    margin: 0;
  }

  .gallery__grid {
    columns: 2;
    column-gap: var(--space-4);
  }

  .gallery__action {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  .gallery__drive-btn {
    align-items: center;
    background: var(--color-signal);
    border: var(--rule-width) solid var(--color-signal);
    color: var(--color-on-signal, var(--color-text-inverse));
    display: inline-flex;
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    gap: var(--space-3);
    justify-content: center;
    min-height: var(--space-12);
    min-width: min(28rem, 100%);
    padding: var(--space-3) var(--space-8);
    text-align: center;
    transition: background-color var(--transition-micro), border-color var(--transition-micro), transform var(--transition-micro);
  }

  .gallery__drive-btn:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-text-inverse);
    transform: translateY(-2px);
  }

  @media (min-width: 48rem) {
    .gallery__grid {
      columns: 3;
    }
  }

  @media (min-width: 72rem) {
    .gallery__grid {
      columns: 4;
    }
  }

  :global(.gallery__item) {
    break-inside: avoid;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 var(--space-4);
    background: rgba(216, 207, 196, 0.08);
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  :global(.gallery__item img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 8px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  :global(.gallery__item:hover img) {
    opacity: 0.88;
    transform: scale(1.02);
  }

  :global(.gallery__caption) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: linear-gradient(to top, rgba(26, 26, 26, 0.82), transparent);
    color: #F7F3EE;
    font-family: var(--font-display);
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  :global(.gallery__item:hover .gallery__caption) {
    opacity: 1;
    transform: translateY(0);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    animation: lightboxIn 0.25s ease;
  }

  .lightbox[hidden] {
    display: none;
  }

  @keyframes lightboxIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lightbox__img-wrap {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__img {
    max-width: 90vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6);
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: fixed;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    color: #fff;
  }

  .lightbox__close:hover,
  .lightbox__prev:hover,
  .lightbox__next:hover {
    background: rgba(255,255,255,0.2);
    transform: scale(1.1);
  }

  .lightbox__close svg,
  .lightbox__prev svg,
  .lightbox__next svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__close {
    top: var(--space-5);
    right: var(--space-5);
  }

  .lightbox__prev {
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .lightbox__next {
    right: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__next:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .lightbox__counter {
    position: fixed;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.6);
    font-family: var(--font-display);
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const grid = document.getElementById('gallery-grid');
    const lightbox = document.getElementById('lightbox');
    const lbImg = document.getElementById('lightbox-img');
    const lbCounter = document.getElementById('lightbox-counter');
    const lbClose = document.getElementById('lightbox-close');
    const lbPrev = document.getElementById('lightbox-prev');
    const lbNext = document.getElementById('lightbox-next');

    if (!lightbox || !grid) return;

    let photos = [];
    let currentIndex = 0;

    function initLightbox() {
      const items = Array.from(grid.querySelectorAll('.gallery__item'));
      photos = items.map((btn) => ({
        src: btn.dataset.src || '',
        title: btn.dataset.title || ''
      }));

      items.forEach((btn, i) => {
        btn.setAttribute('data-index', i);
        btn.onclick = () => openLightbox(i);
      });
    }

    function openLightbox(index) {
      if (photos.length === 0) return;
      currentIndex = index;
      updateLightbox();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      if (lbClose) lbClose.focus();
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (!photos[currentIndex] || !lbImg) return;
      lbImg.src = photos[currentIndex].src;
      lbImg.alt = photos[currentIndex].title || 'Foto produk Roller Customize ' + (currentIndex + 1);
      if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + photos.length;
    }

    function prevPhoto() {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      updateLightbox();
    }

    function nextPhoto() {
      currentIndex = (currentIndex + 1) % photos.length;
      updateLightbox();
    }

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lbPrev) lbPrev.addEventListener('click', prevPhoto);
    if (lbNext) lbNext.addEventListener('click', nextPhoto);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevPhoto();
      if (e.key === 'ArrowRight') nextPhoto();
    });

    // Initialize with initial server photos first
    initLightbox();

    var section = grid.closest('.gallery');
    var cat = (section && section.getAttribute('data-category')) || 'home';

    // Fetch photos from database/API filtered by category and sync if DB has data
    fetch('/api/admin?category=' + cat)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success && Array.isArray(data.photos) && data.photos.length > 0) {
          grid.innerHTML = '';

          data.photos.forEach(function(photo, i) {
            var btn = document.createElement('button');
            btn.className = 'gallery__item';
            btn.setAttribute('data-index', i);
            btn.setAttribute('data-src', photo.image);
            btn.setAttribute('data-title', photo.title || ('Foto produk ' + (i + 1)));
            btn.setAttribute('aria-label', 'Buka foto produk ' + (i + 1));

            var img = document.createElement('img');
            img.src = photo.image;
            img.alt = photo.title || ('Foto produk Roller Customize ' + (i + 1));
            img.loading = 'lazy';
            img.decoding = 'async';
            img.width = 600;
            img.height = 800;

            var span = document.createElement('span');
            span.className = 'gallery__caption';
            span.textContent = photo.title || ('Foto produk ' + (i + 1));

            btn.appendChild(img);
            btn.appendChild(span);
            grid.appendChild(btn);
          });

          initLightbox();
        }
      })
      .catch(function(err) {
        console.log('Gallery: error syncing photos from API', err);
      });
  });
</script>
