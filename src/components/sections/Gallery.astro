---
import galleryData from "../../data/gallery.json"

const galleryItems = (galleryData.items || galleryData).filter((item) => item.image !== "/hero/hero.jpg")
---

<section class="gallery" aria-labelledby="gallery-title">
  <div class="gallery__header">
    <span class="gallery__tag">Lookbook</span>
    <h2 id="gallery-title">Production Archive</h2>
    <p>Berikut adalah arsip dokumentasi dari project yang pernah kami kerjakan.</p>
  </div>

  <div class="gallery__grid" id="gallery-grid">
    {galleryItems.map((item, i) => (
      <button
        class="gallery__item"
        data-index={i}
        data-src={item.image}
        data-title={item.title || `Foto produk ${i + 1}`}
        aria-label={`Buka foto produk ${i + 1}`}
      >
        <img
          src={item.image}
          alt={item.title || `Foto produk Roller Customize ${i + 1}`}
          loading="lazy"
          decoding="async"
          width="600"
          height="800"
        />
      </button>
    ))}
  </div>

  <script is:inline>
    // Sync dynamic photos from LocalStorage / Admin Dashboard
    (function renderCustomGallery() {
      function sync() {
        try {
          const storedItems = localStorage.getItem("rc_custom_gallery");
          if (storedItems) {
            const parsed = JSON.parse(storedItems);
            const grid = document.getElementById("gallery-grid");
            if (grid && Array.isArray(parsed) && parsed.length > 0) {
              grid.innerHTML = parsed.map((item, i) => `
                <button
                  class="gallery__item"
                  data-index="${i}"
                  data-src="${item.image}"
                  data-title="${item.title || 'Foto Produk'}"
                  aria-label="Buka foto produk ${i + 1}"
                >
                  <img
                    src="${item.image}"
                    alt="${item.title || 'Foto Produk Roller Customize'}"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="800"
                  />
                </button>
              `).join("");
            }
          }
        } catch (e) {
          console.error(e);
        }
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", sync);
      } else {
        sync();
      }
    })();
  </script>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Lightbox foto" hidden>
    <button class="lightbox__close" id="lightbox-close" aria-label="Tutup lightbox">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <button class="lightbox__prev" id="lightbox-prev" aria-label="Foto sebelumnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lightbox__next" id="lightbox-next" aria-label="Foto berikutnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lightbox__img-wrap">
      <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox__counter" id="lightbox-counter">1 / 15</div>
  </div>
</section>

<style>
  .gallery {
    background: var(--color-canvas);
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-20) var(--layout-edge);
  }

  .gallery__header {
    max-width: 36rem;
    margin-bottom: var(--space-12);
  }

  .gallery__tag {
    display: inline-block;
    color: var(--color-signal);
    font-size: var(--type-label);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .gallery__header h2 {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 var(--space-4);
  }

  .gallery__header p {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    margin: 0;
  }

  .gallery__grid {
    columns: 2;
    column-gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .gallery__grid {
      columns: 3;
    }
  }

  @media (min-width: 72rem) {
    .gallery__grid {
      columns: 4;
    }
  }

  .gallery__item {
    break-inside: avoid;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 var(--space-4);
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .gallery__item img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 8px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .gallery__item:hover img {
    opacity: 0.88;
    transform: scale(1.02);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    animation: lightboxIn 0.25s ease;
  }

  .lightbox[hidden] {
    display: none;
  }

  @keyframes lightboxIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lightbox__img-wrap {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__img {
    max-width: 90vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6);
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: fixed;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    color: #fff;
  }

  .lightbox__close:hover,
  .lightbox__prev:hover,
  .lightbox__next:hover {
    background: rgba(255,255,255,0.2);
    transform: scale(1.1);
  }

  .lightbox__close svg,
  .lightbox__prev svg,
  .lightbox__next svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__close {
    top: var(--space-5);
    right: var(--space-5);
  }

  .lightbox__prev {
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .lightbox__next {
    right: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__next:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .lightbox__counter {
    position: fixed;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.6);
    font-family: var(--font-display);
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryItems = Array.from(document.querySelectorAll('.gallery__item'));
    if (galleryItems.length === 0) return;

    const photos = galleryItems.map((btn) => ({
      src: btn.dataset.src || '',
      title: btn.dataset.title || ''
    }));

    let currentIndex = 0;

    const lightbox   = document.getElementById('lightbox');
    const lbImg      = document.getElementById('lightbox-img');
    const lbCounter  = document.getElementById('lightbox-counter');
    const lbClose    = document.getElementById('lightbox-close');
    const lbPrev     = document.getElementById('lightbox-prev');
    const lbNext     = document.getElementById('lightbox-next');

    if (!lightbox) return;

    function openLightbox(index) {
      if (photos.length === 0) return;
      currentIndex = index;
      updateLightbox();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      if (lbClose) lbClose.focus();
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (!photos[currentIndex] || !lbImg) return;
      lbImg.src = photos[currentIndex].src;
      lbImg.alt = photos[currentIndex].title || `Foto produk Roller Customize ${currentIndex + 1}`;
      if (lbCounter) lbCounter.textContent = `${currentIndex + 1} / ${photos.length}`;
    }

    function prevPhoto() {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      updateLightbox();
    }

    function nextPhoto() {
      currentIndex = (currentIndex + 1) % photos.length;
      updateLightbox();
    }

    galleryItems.forEach((btn) => {
      btn.addEventListener('click', () => openLightbox(Number(btn.dataset.index)));
    });

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lbPrev) lbPrev.addEventListener('click', prevPhoto);
    if (lbNext) lbNext.addEventListener('click', nextPhoto);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevPhoto();
      if (e.key === 'ArrowRight') nextPhoto();
    });
  });
</script>
