---
import { clients } from "../../data/company"
import clientLogos from "../../data/client_logos.json"

type Props = {
  readonly heading?: string
  readonly allClients?: boolean
}

const { heading = "Nama-nama yang pernah bekerja bersama kami.", allClients = false } = Astro.props
const logos = clientLogos.logos || clientLogos
// Gunakan semua logo yang tersedia agar marquee kaya dan penuh
const marqueeLogos = logos.length < 10 ? [...logos, ...logos] : logos
const visibleClients = allClients ? clients : clients.slice(0, 8)
---

<section class:list={["clients", { "clients--all": allClients }]} aria-labelledby="clients-title">
  <header class="clients__heading">
    <p>Rekam kerja</p>
    <h2 id="clients-title">{heading}</h2>
    <span>Universitas, instansi, organisasi, dan perusahaan.</span>
  </header>

  <div class="clients__marquee" aria-label="Logo mitra Roller Customize">
    <div class="clients__track">
      <div class="clients__logo-set">
        {marqueeLogos.map((logo) => (
          <div class="clients__logo"><img src={logo.image} alt={logo.title} loading="lazy" /></div>
        ))}
      </div>
      <div class="clients__logo-set" aria-hidden="true">
        {marqueeLogos.map((logo) => (
          <div class="clients__logo"><img src={logo.image} alt="" loading="lazy" /></div>
        ))}
      </div>
    </div>
    <div class="clients__track clients__track--reverse" aria-hidden="true">
      <div class="clients__logo-set">
        {[...marqueeLogos].reverse().map((logo) => (
          <div class="clients__logo"><img src={logo.image} alt="" loading="lazy" /></div>
        ))}
      </div>
      <div class="clients__logo-set">
        {[...marqueeLogos].reverse().map((logo) => (
          <div class="clients__logo"><img src={logo.image} alt="" loading="lazy" /></div>
        ))}
      </div>
    </div>
  </div>

  <div class="clients__directory">
    {visibleClients.map((client, index) => (
      <article class="client">
        <span class="client__index">{String(index + 1).padStart(2, "0")}</span>
        {logos[index] && <img src={logos[index].image} alt="" loading="lazy" />}
        <h3>{client.name}</h3>
        <p>{client.sector}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .clients {
    background: var(--color-mist);
    padding: var(--space-24) var(--layout-edge);
  }

  .clients__heading,
  .clients__marquee,
  .clients__directory {
    margin: 0 auto;
    max-width: var(--layout-max);
  }

  .clients__heading {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .clients__heading p {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--type-h2);
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0;
    max-width: 18ch;
  }

  .clients__heading span {
    color: var(--color-text-muted);
  }

  .clients__marquee {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    overflow: hidden;
    width: 100%;
  }

  .clients__track {
    --marquee-gap: var(--space-5);
    --marquee-half-gap: calc(var(--marquee-gap) / 2);
    animation: clients-marquee-left 50s linear infinite;
    display: flex;
    gap: var(--marquee-gap);
    width: max-content;
    will-change: transform;
  }

  .clients__track.clients__track--reverse {
    animation: clients-marquee-right 55s linear infinite;
  }

  .clients__logo-set {
    display: flex;
    gap: var(--marquee-gap);
  }

  .clients__logo {
    align-items: center;
    background: color-mix(in oklch, var(--color-canvas) 72%, transparent);
    border: var(--rule-width) solid color-mix(in oklch, var(--color-ink) 16%, transparent);
    display: flex;
    height: 5rem;
    justify-content: center;
    padding: var(--space-3);
    width: 6.5rem;
    transition: background-color var(--transition-micro), transform var(--transition-micro);
    flex-shrink: 0;
  }

  .clients__logo:hover {
    background: var(--color-canvas);
    transform: translateY(-3px);
  }

  .clients__logo img {
    filter: grayscale(1);
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.68;
    transition: filter var(--transition-micro), opacity var(--transition-micro);
  }

  .clients__logo:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  .clients__marquee:hover .clients__track {
    animation-play-state: paused;
  }

  .clients__directory {
    border-top: 2px solid var(--color-ink);
  }

  .client {
    align-items: center;
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--color-ink) 22%, transparent);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1.5rem 3rem 1fr;
    padding: var(--space-4) 0;
  }

  .client__index,
  .client p {
    color: var(--color-text-muted);
    font-size: var(--type-small);
  }

  .client img {
    height: 2.75rem;
    object-fit: contain;
    width: 2.75rem;
  }

  h3 {
    font-size: var(--type-body);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .client p {
    grid-column: 3;
    margin: calc(var(--space-3) * -1) 0 0;
  }

  .clients--all .clients__marquee {
    display: none;
  }

  .clients--all .clients__directory {
    --color-ink: #1a1a1a;
    --color-text-muted: #3d352e;
    border-top: 2px solid var(--color-ink);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .clients--all .client {
    align-content: start;
    background: var(--color-canvas);
    border: var(--rule-width) solid color-mix(in oklch, var(--color-ink) 18%, transparent);
    color: var(--color-ink);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1.5rem 1fr;
    min-height: 12rem;
    padding: var(--space-5);
  }

  .clients--all .client img {
    grid-column: 2;
    height: 5rem;
    justify-self: start;
    width: 5rem;
  }

  .clients--all .client h3 {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .clients--all .client p {
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .clients__heading {
      align-items: end;
      grid-template-columns: 0.5fr 1.5fr 1fr;
    }

    .client {
      grid-template-columns: 3rem 4rem 1fr 0.5fr;
    }

    .client p {
      grid-column: auto;
      margin: 0;
    }

    .clients--all .clients__directory {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .clients--all .client {
      min-height: 15rem;
    }
  }

  @keyframes clients-marquee-left {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }

  @keyframes clients-marquee-right {
    0% {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }
</style>
