---
import { clients } from "../../data/company"
import clientLogos from "../../data/client_logos.json"

type Props = {
  readonly heading?: string
  readonly allClients?: boolean
}

const { heading = "Dipakai oleh tim dengan standar kerja yang berbeda.", allClients = false } = Astro.props
const logos = clientLogos.logos || clientLogos
const homeLogos = logos.slice(0, 10)
const visibleClients = allClients ? clients : clients.slice(0, 8)
---

<section class:list={["clients", { "clients--all": allClients }]} aria-labelledby="clients-title">
  <header class="clients__heading">
    <p class="clients__eyebrow">04 / Rekam kerja</p>
    <h2 id="clients-title">{heading}</h2>
    <span>Universitas, instansi, organisasi, dan perusahaan.</span>
  </header>

  {!allClients && (
    <>
      <ul class="clients__logo-grid" aria-label="Logo mitra Roller Customize">
        {homeLogos.map((logo) => (
          <li>
            <img src={logo.image} alt={logo.title} loading="lazy" />
          </li>
        ))}
      </ul>
      <div class="clients__note">
        <p>Kepercayaan dibangun dari detail yang konsisten, batch demi batch.</p>
        <a href="/pelanggan">Lihat seluruh daftar pelanggan <span aria-hidden="true">↗</span></a>
      </div>
    </>
  )}

  {allClients && (
    <div class="clients__directory">
      {visibleClients.map((client, index) => (
        <article class="client">
          <span class="client__index">{String(index + 1).padStart(2, "0")}</span>
          {logos[index] && <img src={logos[index].image} alt="" loading="lazy" />}
          <h3>{client.name}</h3>
          <p>{client.sector}</p>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .clients {
    background: var(--color-mist);
    padding: clamp(4rem, 9vw, 7rem) var(--layout-edge);
  }

  .clients__heading,
  .clients__logo-grid,
  .clients__note,
  .clients__directory {
    margin: 0 auto;
    max-width: var(--layout-max);
  }

  .clients__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .clients__eyebrow {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  .clients h2 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.075em;
    line-height: 0.94;
    margin: 0;
    max-width: 13ch;
  }

  .clients__heading > span {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
  }

  .clients__logo-grid {
    border-left: 1px solid color-mix(in oklch, var(--color-ink) 20%, transparent);
    border-top: 1px solid color-mix(in oklch, var(--color-ink) 20%, transparent);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding: 0;
  }

  .clients__logo-grid li {
    align-items: center;
    border-bottom: 1px solid color-mix(in oklch, var(--color-ink) 20%, transparent);
    border-right: 1px solid color-mix(in oklch, var(--color-ink) 20%, transparent);
    display: flex;
    height: 6.25rem;
    justify-content: center;
    padding: var(--space-4);
  }

  .clients__logo-grid img {
    filter: grayscale(1);
    max-height: 4.25rem;
    max-width: 8rem;
    opacity: 0.66;
    object-fit: contain;
    transition: filter var(--transition-micro), opacity var(--transition-micro), transform var(--transition-micro);
  }

  .clients__logo-grid li:hover img {
    filter: grayscale(0);
    opacity: 1;
    transform: scale(1.04);
  }

  .clients__note {
    align-items: center;
    border-bottom: 1px solid color-mix(in oklch, var(--color-ink) 24%, transparent);
    display: flex;
    gap: var(--space-6);
    justify-content: space-between;
    padding: var(--space-5) 0;
  }

  .clients__note p,
  .clients__note a {
    font-size: var(--type-small);
    margin: 0;
  }

  .clients__note p {
    color: var(--color-text-muted);
  }

  .clients__note a {
    border-bottom: 1px solid currentColor;
    font-weight: var(--font-weight-semibold);
    min-height: 2.75rem;
    padding-block: var(--space-2);
    white-space: nowrap;
  }

  .clients__note a:hover {
    color: var(--color-ink);
  }

  .clients__directory {
    border-top: 2px solid var(--color-ink);
  }

  .client {
    align-items: center;
    border-bottom: 1px solid color-mix(in oklch, var(--color-ink) 22%, transparent);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1.5rem 3rem 1fr;
    padding: var(--space-4) 0;
  }

  .client__index,
  .client p {
    color: var(--color-text-muted);
    font-size: var(--type-small);
  }

  .client img {
    height: 2.75rem;
    object-fit: contain;
    width: 2.75rem;
  }

  .client h3 {
    font-size: var(--type-body);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .client p {
    grid-column: 3;
    margin: calc(var(--space-3) * -1) 0 0;
  }

  @media (min-width: 48rem) {
    .clients__heading {
      align-items: end;
      column-gap: var(--space-8);
      grid-template-columns: 0.5fr 1.5fr 1fr;
    }

    .clients__logo-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .clients__note {
      gap: var(--space-8);
    }

    .client {
      grid-template-columns: 3rem 4rem 1fr 0.5fr;
    }

    .client p {
      grid-column: auto;
      margin: 0;
    }

    .clients--all .clients__directory {
      display: grid;
      gap: var(--space-3);
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .clients--all .client {
      align-content: start;
      background: var(--color-canvas);
      border: 1px solid color-mix(in oklch, var(--color-ink) 18%, transparent);
      display: grid;
      gap: var(--space-3);
      grid-template-columns: 1.5rem 1fr;
      min-height: 14rem;
      padding: var(--space-5);
    }

    .clients--all .client img {
      grid-column: 2;
      height: 5rem;
      width: 5rem;
    }

    .clients--all .client h3,
    .clients--all .client p {
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  @media (max-width: 30rem) {
    .clients__note {
      align-items: start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .clients__note a {
      white-space: normal;
    }
  }
</style>
