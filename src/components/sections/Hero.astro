---
import { company } from "../../data/company"
import Button from "../ui/Button.astro"
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg">
    <img
      src={company.heroImage.src}
      alt={company.heroImage.alt}
      width="1600"
      height="900"
      srcset={company.heroImage.srcSet}
      sizes="100vw"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>
  <div class="hero__content">
    <h1 id="hero-title">{company.name}</h1>
    <p class="hero__quote">"{company.tagline}"</p>
    <div class="hero__actions">
      <Button href="/kontak" label="Selengkapnya" />
      <Button href="/kontak" label="Hubungi Kami" variant="quiet" />
    </div>
  </div>
  <svg class="hero__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0,64 C360,120 720,0 1080,80 C1260,110 1380,90 1440,80 L1440,120 L0,120 Z"
      fill="var(--color-signal)"
    />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__bg {
    position: relative;
    min-height: 80vh;
  }

  .hero__bg img {
    display: block;
    height: 100%;
    min-height: 80vh;
    object-fit: cover;
    object-position: center 30%;
    position: absolute;
    inset: 0;
    width: 100%;
  }

  .hero__overlay {
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--color-ink) 15%, transparent) 0%,
      color-mix(in oklch, var(--color-ink) 35%, transparent) 50%,
      color-mix(in oklch, var(--color-ink) 50%, transparent) 100%
    );
    inset: 0;
    position: absolute;
  }

  .hero__content {
    align-items: center;
    color: var(--color-text-inverse);
    display: flex;
    flex-direction: column;
    inset: 0;
    justify-content: center;
    padding: var(--space-20) var(--layout-edge) var(--space-24);
    position: absolute;
    text-align: center;
    z-index: 1;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    text-shadow: 0 2px 24px color-mix(in oklch, var(--color-ink) 60%, transparent);
  }

  .hero__quote {
    color: var(--color-text-inverse);
    font-size: clamp(1.125rem, 2.5vw, 1.75rem);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: var(--space-6) 0 0;
    text-shadow: 0 1px 12px color-mix(in oklch, var(--color-ink) 50%, transparent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  .hero__wave {
    display: block;
    height: auto;
    margin-bottom: -2px;
    position: relative;
    width: 100%;
    z-index: 2;
  }

  @media (min-width: 48rem) {
    .hero__bg {
      min-height: 85vh;
    }

    .hero__bg img {
      min-height: 85vh;
    }
  }

  @media (min-width: 64rem) {
    .hero__bg {
      min-height: 90vh;
    }

    .hero__bg img {
      min-height: 90vh;
    }

    .hero__content {
      padding-bottom: var(--space-20);
    }
  }
</style>
