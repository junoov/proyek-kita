---
import { company } from "../../data/company"
import Button from "../ui/Button.astro"

const boardImages = [
  {
    src: company.studioImage.src,
    alt: company.studioImage.alt,
    label: "01 / PRODUK JADI",
    className: "hero__figure--main",
    width: 1334,
    height: 2000,
    sizes: "(max-width: 767px) 63vw, (max-width: 1023px) 42vw, 32vw"
  },
  {
    src: "/gallery/dsc06446.jpg",
    alt: "Detail bordir Engineering Club di bagian belakang workshirt",
    label: "02 / DETAIL BORDIR",
    className: "hero__figure--detail",
    width: 1334,
    height: 2000,
    sizes: "(max-width: 767px) 34vw, (max-width: 1023px) 25vw, 20vw"
  },
  {
    src: company.heroImage.src,
    alt: "Katalog bahan dan pilihan warna untuk produksi seragam",
    label: "03 / MATERIAL",
    className: "hero__figure--material",
    width: 1920,
    height: 1280,
    sizes: "(max-width: 767px) 34vw, (max-width: 1023px) 25vw, 20vw"
  }
] as const
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__topline">
    <span>RC / 2024—NOW</span>
    <span>WORKWEAR STUDIO / YOGYAKARTA</span>
  </div>

  <div class="hero__content">
    <div class="hero__statement">
      <p class="hero__eyebrow">Seragam custom untuk tim yang terus bergerak</p>
      <h1 id="hero-title">
        Mitra Terpercaya untuk
        <span>Kebutuhan Konveksi Anda</span>
      </h1>
      <p class="hero__lede">
        Roller Customize adalah konveksi yang berfokus pada produksi custom Workshirt, PDL/PDH, Workjacket, Kaos, Celana, dan Totebag dengan pendekatan yang sederhana, rapi, dan presisi.
      </p>
      <div class="hero__actions">
        <Button href="/kontak" label="Diskusikan kebutuhan" variant="signal" />
        <a class="hero__text-link" href="#selected-work">Lihat hasil produksi <span aria-hidden="true">↓</span></a>
      </div>
      <dl class="hero__specs" aria-label="Ringkasan layanan">
        <div>
          <dt>Mulai dari</dt>
          <dd>24 pcs</dd>
        </div>
        <div>
          <dt>Metode</dt>
          <dd>Custom brief</dd>
        </div>
        <div>
          <dt>Jangkauan</dt>
          <dd>Seluruh Indonesia</dd>
        </div>
      </dl>
    </div>

    <div class="hero__board" aria-label="Contoh produk dan material Roller Customize">
      {boardImages.map((image, index) => (
        <figure class:list={["hero__figure", image.className]}>
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            sizes={image.sizes}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
            decoding="async"
          />
          <figcaption>{image.label}</figcaption>
        </figure>
      ))}
    </div>

  </div>

  <div class="hero__footline">
    <span>BRIEF → SAMPLE → PRODUCTION → QC</span>
    <span>Setiap detail punya tempatnya.</span>
  </div>
</section>

<style>
  .hero {
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text);
    overflow: clip;
    padding: var(--space-4) var(--layout-edge) var(--space-8);
  }

  .hero__topline,
  .hero__footline {
    align-items: center;
    display: flex;
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    justify-content: space-between;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hero__topline {
    border-bottom: 1px solid var(--color-rule);
    min-height: 2rem;
    padding-bottom: var(--space-3);
  }

  .hero__topline span:last-child,
  .hero__footline span:last-child {
    color: var(--color-text-muted);
  }

  .hero__content {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .hero__statement {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__eyebrow {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.09em;
    line-height: 1.4;
    margin: 0;
    max-width: 30ch;
    text-transform: uppercase;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3.15rem, 12vw, 5.3rem);
    font-weight: var(--font-weight-heavy);
    letter-spacing: -0.085em;
    line-height: 0.9;
    margin: 0;
    max-width: 8.7ch;
  }

  .hero h1 span {
    color: var(--color-signal);
    display: block;
    font-weight: var(--font-weight-regular);
  }

  .hero__lede {
    font-size: var(--type-lead);
    line-height: 1.55;
    margin: var(--space-2) 0 0;
    max-width: 36ch;
  }

  .hero__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .hero :global(.button--signal) {
    min-width: 12.5rem;
  }

  .hero__text-link {
    align-items: center;
    border-bottom: 1px solid currentColor;
    display: inline-flex;
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) 0;
    transition: color var(--transition-micro), border-color var(--transition-micro);
  }

  .hero__text-link:hover {
    border-color: var(--color-signal);
    color: var(--color-ink);
  }

  .hero__specs {
    border-top: 1px solid var(--color-rule);
    display: grid;
    gap: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-5) 0 0;
    max-width: 38rem;
  }

  .hero__specs div {
    border-right: 1px solid var(--color-rule);
    display: grid;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-3) var(--space-3) 0 0;
  }

  .hero__specs div + div {
    padding-left: var(--space-3);
  }

  .hero__specs div:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .hero__specs dt {
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__specs dd {
    font-size: var(--type-small);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    margin: 0;
  }

  .hero__board {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 1.15fr 0.85fr;
    grid-template-rows: minmax(0, 1.15fr) minmax(0, 0.85fr);
    height: 29rem;
    min-height: 0;
  }

  .hero__figure {
    background: var(--color-mist);
    margin: 0;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }

  .hero__figure--main {
    grid-row: 1 / -1;
  }

  .hero__figure img {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-standard);
    width: 100%;
  }

  .hero__figure:hover img {
    transform: scale(1.02);
  }

  .hero__figure--main img {
    object-position: center 34%;
  }

  .hero__figure--detail img {
    object-position: center 34%;
  }

  .hero__figure--material img {
    object-position: center;
  }

  .hero__figure figcaption {
    background: var(--color-ink);
    bottom: 0;
    color: var(--color-text-inverse);
    font-size: 0.62rem;
    font-weight: var(--font-weight-bold);
    left: 0;
    letter-spacing: 0.1em;
    padding: var(--space-2) var(--space-3);
    position: absolute;
  }

  .hero__footline {
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    .hero {
      padding: var(--space-5) var(--layout-edge) var(--space-6);
    }

    .hero__content {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      padding-block: var(--space-10);
    }

    .hero__board {
      height: min(34rem, 62vw);
      order: 1;
    }

    .hero__statement {
      align-items: start;
      display: grid;
      column-gap: var(--space-10);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      order: 2;
    }

    .hero__eyebrow,
    .hero h1 {
      grid-column: 1;
    }

    .hero__eyebrow {
      grid-row: 1;
    }

    .hero h1 {
      grid-row: 2 / span 3;
    }

    .hero__lede,
    .hero__actions,
    .hero__specs {
      grid-column: 2;
    }

    .hero__lede {
      grid-row: 1 / span 2;
      margin-top: 0;
    }

    .hero__actions {
      grid-row: 3;
    }

    .hero__specs {
      grid-row: 4;
      margin-top: var(--space-4);
    }

    .hero h1 {
      font-size: clamp(4.2rem, 7vw, 6.5rem);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-inline: max(var(--layout-edge), calc((100vw - var(--layout-max)) / 2));
    }

    .hero__content {
      align-items: center;
      column-gap: var(--space-16);
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .hero__statement {
      display: grid;
      gap: var(--space-5);
      grid-template-columns: minmax(0, 1fr);
      order: initial;
    }

    .hero__statement > * {
      grid-column: auto;
      grid-row: auto;
    }

    .hero__lede {
      margin-top: var(--space-2);
    }

    .hero__specs {
      margin-top: var(--space-5);
    }

    .hero__board {
      height: min(40rem, 48vw);
      order: initial;
    }

    .hero h1 {
      font-size: clamp(3.5rem, 4vw, 4.25rem);
      letter-spacing: -0.065em;
      line-height: 0.94;
      max-width: none;
    }
  }

  @media (max-width: 30rem) {
    .hero {
      padding-top: var(--space-3);
    }

    .hero__topline,
    .hero__footline {
      font-size: 0.58rem;
    }

    .hero__topline span:last-child,
    .hero__footline span:last-child {
      display: none;
    }

    .hero__content {
      gap: var(--space-8);
      padding-block: var(--space-8) var(--space-6);
    }

    .hero h1 {
      font-size: clamp(3.25rem, 14vw, 4.35rem);
    }

    .hero__lede {
      font-size: 1rem;
      max-width: 34ch;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
      gap: var(--space-2);
    }

    .hero :global(.button--signal) {
      width: 100%;
    }

    .hero__text-link {
      align-self: flex-start;
    }

    .hero__specs {
      margin-top: var(--space-4);
    }

    .hero__specs div {
      padding-top: var(--space-3);
    }

    .hero__specs dt {
      font-size: 0.58rem;
    }

    .hero__specs dd {
      font-size: 0.78rem;
    }

    .hero__board {
      height: 30rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__figure img {
      transition: none;
    }
  }
</style>
