---
import { company } from "../../data/company"
import Button from "../ui/Button.astro"
---

<section class="hero" aria-labelledby="hero-title">
  <figure class="hero__visual">
    <img
      class="hero__image hero__image--primary"
      src={company.heroImage.src}
      alt={company.heroImage.alt}
      width="1920"
      height="1280"
      srcset={company.heroImage.srcSet}
      sizes="100vw"
      fetchpriority="high"
      decoding="async"
    />
    <img
      class="hero__image hero__image--secondary"
      src="/hero/hero-2.jpg"
      alt=""
      width="1280"
      height="853"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <img
      class="hero__image hero__image--tertiary"
      src="/hero/hero-3.jpg"
      alt=""
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <img
      class="hero__image hero__image--quaternary"
      src="/hero/hero-4.jpg"
      alt=""
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <div class="hero__overlay"></div>
  </figure>

  <div class="hero__copy">
    <h1 id="hero-title">
      <span class="hero__title-desktop">Mitra Terpercaya untuk<br />Kebutuhan <em>Konveksi Anda</em></span>
      <span class="hero__title-mobile">Mitra Terpercaya untuk<br />Kebutuhan <em>Konveksi Anda</em></span>
    </h1>
    <p class="hero__lede">
      <span class="hero__lede-desktop">Roller Customize adalah konveksi yang berfokus pada produksi custom Workshirt, PDL/PDH, Workjacket, Kaos, Celana, dan Totebag dengan pendekatan yang sederhana, rapi, dan presisi.</span>
      <span class="hero__lede-mobile">Roller Customize adalah konveksi yang berfokus pada produksi custom Workshirt, PDL/PDH, Workjacket, Kaos, Celana, dan Totebag dengan pendekatan yang sederhana, rapi, dan presisi.</span>
    </p>
    <div class="hero__actions">
      <span class="hero__action-desktop"><Button href="/kontak" label="Konsultasi kebutuhan" variant="signal" /></span>
      <a class="hero__text-link" href="/layanan">Roadmap produksi</a>
    </div>
  </div>
  <div class="hero__mobile-action"><Button href="/kontak" label="Konsultasi kebutuhan" variant="signal" /></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 4.5rem);
    padding: var(--space-16) var(--layout-edge) var(--space-12);
    overflow: hidden;
    color: var(--color-text-inverse);
    background: var(--color-ink);
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    z-index: 1;
  }

  .hero__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 15% top;
    filter: brightness(0.85) contrast(1.04);
  }

  .hero__image--primary {
    animation: hero-slide-left 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .hero__visual .hero__image--secondary,
  .hero__visual .hero__image--tertiary,
  .hero__visual .hero__image--quaternary {
    object-position: center;
  }

  .hero__image--secondary {
    animation: hero-slide-left 8s -6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .hero__image--tertiary {
    animation: hero-slide-left 8s -4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .hero__image--quaternary {
    animation: hero-slide-left 8s -2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-slide-left {
    0%, 20% { transform: translate3d(0, 0, 0); }
    25% { transform: translate3d(-100%, 0, 0); }
    25.01%, 95% { transform: translate3d(100%, 0, 0); }
    100% { transform: translate3d(0, 0, 0); }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 12, 10, 0.45) 0%, rgba(15, 12, 10, 0.55) 50%, rgba(15, 12, 10, 0.75) 100%);
    z-index: 2;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 58rem;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  h1,
  h1 span,
  h1 em,
  .hero__title-desktop,
  .hero__title-mobile {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: clamp(2.5rem, 7.5vw, 5.5rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0;
    color: #ffefdf !important;
    font-style: normal;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }

  .hero__lede {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    margin: var(--space-6) auto 0;
    max-width: 44rem;
    color: rgba(255, 255, 255, 0.9);
  }

  :global(.hero__title-mobile),
  :global(.hero__lede-mobile),
  :global(.hero__mobile-action) {
    display: none;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .hero__text-link {
    border-bottom: var(--rule-width) solid currentColor;
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
    padding-block: var(--space-2);
    transition: opacity var(--transition-micro);
  }

  .hero__text-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: clamp(380px, 110vw, 500px);
      padding: var(--space-6) var(--layout-edge) var(--space-6);
    }

    .hero__visual img {
      object-position: 38% 20%;
    }

    .hero__visual .hero__image--secondary,
    .hero__visual .hero__image--tertiary,
    .hero__visual .hero__image--quaternary {
      object-position: center;
    }

    .hero__visual figcaption {
      display: none;
    }

    .hero__copy {
      width: 100%;
      padding: 0;
      margin: 0;
    }

    h1 {
      font-size: clamp(1.8rem, 7.5vw, 2.7rem);
      line-height: 1.05;
    }

    .hero__lede {
      font-size: 0.9rem;
      margin-top: var(--space-2);
      max-width: 22rem;
      line-height: 1.45;
    }

    :global(.hero__title-desktop),
    :global(.hero__lede-desktop),
    :global(.hero__action-desktop) {
      display: none;
    }

    :global(.hero__title-mobile),
    :global(.hero__lede-mobile) {
      display: inline;
    }

    :global(.hero__mobile-action) {
      display: block;
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: 100%;
      margin-top: var(--space-3);
    }

    :global(.hero__mobile-action .button) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image--primary,
    .hero__image--secondary,
    .hero__image--tertiary,
    .hero__image--quaternary {
      animation: none;
    }

    .hero__image--secondary,
    .hero__image--tertiary,
    .hero__image--quaternary {
      opacity: 0;
    }
  }
</style>
