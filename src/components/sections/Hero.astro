---
import { company } from "../../data/company"
import Button from "../ui/Button.astro"
---

<section class="hero" aria-labelledby="hero-title">
  <figure class="hero__visual">
    <img
      src={company.heroImage.src}
      alt={company.heroImage.alt}
      width="1920"
      height="1280"
      srcset={company.heroImage.srcSet}
      sizes="100vw"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__overlay"></div>
    <figcaption>
      <span>RC / 01</span>
      Workshirt hitam, dokumentasi produk 2026
    </figcaption>
  </figure>

  <div class="hero__copy">
    <p class="hero__index">Garmen kustom · Sleman, Yogyakarta</p>
    <h1 id="hero-title">
      <span class="hero__title-desktop">Seragam kerja<br />yang siap <em>dipakai.</em></span>
      <span class="hero__title-mobile">Seragam kerja<br />yang siap <em>dipakai.</em></span>
    </h1>
    <p class="hero__lede">
      <span class="hero__lede-desktop">Kami merancang workshirt untuk kebutuhan tim, lalu menjaganya tetap konsisten dari sampel sampai batch produksi.</span>
      <span class="hero__lede-mobile">Merancang workshirt kustom konsisten dari sampel hingga batch produksi.</span>
    </p>
    <div class="hero__actions">
      <span class="hero__action-desktop"><Button href="/kontak" label="Bahas kebutuhan tim" variant="signal" /></span>
      <a class="hero__text-link" href="/layanan">Lihat cara kerja</a>
    </div>
    <dl class="hero__facts">
      <div>
        <dt>Fokus</dt>
        <dd>Workshirt & seragam tim</dd>
      </div>
      <div>
        <dt>Kontrol</dt>
        <dd>Ukuran, jahitan, warna, identitas</dd>
      </div>
    </dl>
  </div>
  <div class="hero__mobile-action"><Button href="/kontak" label="Diskusikan seragam tim" variant="signal" /></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 4.5rem);
    padding: var(--space-16) var(--layout-edge) var(--space-12);
    overflow: hidden;
    color: #ffffff;
    background: var(--color-ink);
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    z-index: 1;
  }

  .hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 15% top;
    transform: scale(1.08);
    transform-origin: 15% top;
    filter: brightness(1.12) contrast(1.03);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 12, 10, 0.12) 0%,
      rgba(15, 12, 10, 0.28) 50%,
      rgba(15, 12, 10, 0.48) 100%
    );
    z-index: 2;
  }

  .hero__visual figcaption {
    position: absolute;
    bottom: var(--space-4);
    left: var(--layout-edge);
    z-index: 3;
    display: flex;
    gap: var(--space-3);
    font-size: var(--type-small);
    color: rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.4);
    padding: var(--space-2) var(--space-3);
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .hero__visual figcaption span {
    color: #f7a361;
    font-weight: 800;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 58rem;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  .hero__index {
    color: #f7a361;
    font-size: var(--type-label);
    font-weight: 800;
    letter-spacing: 0.14em;
    margin: 0 0 var(--space-4);
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 6.2rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  h1 em {
    color: #f7a361;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-style: italic;
  }

  .hero__lede {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    margin: var(--space-6) auto 0;
    max-width: 38rem;
    color: rgba(255, 255, 255, 0.9);
  }

  :global(.hero__title-mobile),
  :global(.hero__lede-mobile),
  :global(.hero__mobile-action) {
    display: none;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .hero__text-link {
    border-bottom: var(--rule-width) solid currentColor;
    font-size: var(--type-small);
    font-weight: 720;
    color: #ffffff;
    padding-block: var(--space-2);
    transition: opacity var(--transition-micro);
  }

  .hero__text-link:hover {
    opacity: 0.8;
  }

  .hero__facts {
    border-top: var(--rule-width) solid rgba(255, 255, 255, 0.2);
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-10) auto 0;
    padding-top: var(--space-6);
    width: 100%;
    max-width: 32rem;
    text-align: center;
  }

  .hero__facts div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero__facts dt {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--type-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero__facts dd {
    color: #ffffff;
    font-size: var(--type-small);
    font-weight: 700;
    margin: 0;
  }

  @media (max-width: 48rem) {
    .hero {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: clamp(380px, 110vw, 500px);
      padding: var(--space-6) var(--layout-edge) var(--space-6);
      color: #ffffff;
      background: var(--color-ink);
      overflow: hidden;
    }

    .hero__visual {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      z-index: 1;
      border-radius: 0;
    }

    .hero__visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 38% 20%;
      transform: scale(1);
      transform-origin: center top;
      filter: brightness(1.1) contrast(1.02);
    }

    .hero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(15, 12, 10, 0.25) 0%,
        rgba(15, 12, 10, 0.5) 50%,
        rgba(15, 12, 10, 0.78) 100%
      );
      z-index: 2;
    }

    .hero__visual figcaption {
      display: none;
    }

    .hero__copy {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
      padding: 0;
      margin: 0;
    }

    .hero__index {
      font-size: 0.72rem;
      margin-bottom: var(--space-1);
    }

    h1 {
      font-size: clamp(1.8rem, 7.5vw, 2.7rem);
      line-height: 1.05;
    }

    .hero__lede {
      font-size: 0.9rem;
      margin-top: var(--space-2);
      max-width: 22rem;
      line-height: 1.45;
    }

    :global(.hero__title-desktop),
    :global(.hero__lede-desktop),
    :global(.hero__action-desktop) {
      display: none;
    }

    :global(.hero__title-mobile),
    :global(.hero__lede-mobile) {
      display: inline;
    }

    :global(.hero__mobile-action) {
      display: block;
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: 100%;
      margin-top: var(--space-3);
    }

    :global(.hero__mobile-action .button) {
      width: 100%;
    }

    .hero__facts {
      position: relative;
      z-index: 3;
      margin-top: var(--space-3);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: var(--space-3);
      gap: var(--space-4);
    }

    .hero__facts dt {
      font-size: 0.68rem;
    }

    .hero__facts dd {
      font-size: 0.78rem;
    }
  }
</style>

