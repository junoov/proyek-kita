---
import { company } from "../../data/company"
---

<section class="intro" aria-labelledby="intro-title">
  <p class="intro__label">Yang kami kerjakan</p>
  <div class="intro__statement">
    <h2 id="intro-title">Bukan seragam katalog yang ditempeli logo.</h2>
    <p>
      {company.name} memulai dari pekerjaan orang yang akan mengenakannya: gerak tubuh, lingkungan kerja,
      kebutuhan identitas, dan ritme pemakaian sehari-hari.
    </p>
  </div>
  <dl class="intro__checks">
    <div><dt>01</dt><dd>Fungsi kerja dibahas sebelum visual.</dd></div>
    <div><dt>02</dt><dd>Sampel diperiksa sebelum masuk batch.</dd></div>
    <div><dt>03</dt><dd>Ukuran, jahitan, warna, dan identitas dikontrol sebelum kirim.</dd></div>
  </dl>
</section>

<style>
  .intro {
    background: var(--color-signal);
    color: var(--color-text-inverse);
    display: grid;
    gap: var(--space-8);
    padding: var(--space-20) var(--layout-edge);
  }

  .intro__label {
    font-size: var(--type-label);
    font-weight: 800;
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  .intro__statement {
    display: grid;
    gap: var(--space-8);
  }

  h2 {
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    letter-spacing: -0.07em;
    line-height: 0.92;
    margin: 0;
    max-width: 13ch;
  }

  .intro__statement p {
    font-size: var(--type-lead);
    margin: 0;
    max-width: 34rem;
  }

  .intro__checks {
    border-top: var(--rule-width) solid color-mix(in oklch, var(--color-text-inverse) 38%, transparent);
    display: grid;
    margin: var(--space-6) 0 0;
  }

  .intro__checks div {
    border-bottom: var(--rule-width) solid color-mix(in oklch, var(--color-text-inverse) 38%, transparent);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 2rem 1fr;
    padding: var(--space-5) 0;
  }

  .intro__checks dt {
    font-size: var(--type-label);
  }

  .intro__checks dd {
    font-weight: 700;
    margin: 0;
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: 1fr 3fr;
      padding: var(--space-24) max(var(--layout-edge), calc((100vw - var(--layout-max)) / 2));
    }

    .intro__statement {
      align-items: end;
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    }

    .intro__checks {
      grid-column: 2;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .intro__checks div {
      border-bottom: 0;
      border-right: var(--rule-width) solid color-mix(in oklch, var(--color-text-inverse) 38%, transparent);
      grid-template-columns: 1fr;
      padding: var(--space-5) var(--space-8);
    }

    .intro__checks div:first-child { padding-left: 0; }
    .intro__checks div:last-child { border-right: 0; }
  }
</style>
