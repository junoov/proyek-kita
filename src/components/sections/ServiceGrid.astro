---
import { services } from "../../data/company"
import Button from "../ui/Button.astro"

const process = [
  ...services,
  {
    number: "04",
    title: "QC & Pengiriman",
    description: "Batch diperiksa kembali sebelum dikemas dan dikirim ke alamat tim Anda.",
    deliverable: "Hasil siap dipakai"
  }
]

type Props = {
  readonly heading?: string
  readonly lede?: string
}

const {
  heading = "Semua keputusan penting dibuat sebelum produksi massal.",
  lede = "Alur yang jelas membuat brief lebih mudah diperiksa, direvisi, dan dijalankan."
} = Astro.props
---

<section class="services" aria-labelledby="services-title">
  <header class="services__heading">
    <div>
      <p class="services__eyebrow">03 / Alur produksi</p>
      <h2 id="services-title">{heading}</h2>
    </div>
    <div class="services__intro">
      <p>{lede}</p>
      <Button href="/layanan" label="Lihat alur lengkap" variant="quiet" />
    </div>
  </header>

  <ol class="process-list">
    {process.map((item) => (
      <li class="process-item">
        <span class="process-item__number">{item.number}</span>
        <div class="process-item__body">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
        <span class="process-item__deliverable">{item.deliverable}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .services {
    background: var(--color-canvas);
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: clamp(4rem, 9vw, 7rem) var(--layout-edge);
  }

  .services__heading {
    border-top: 2px solid var(--color-ink);
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-5);
  }

  .services__eyebrow {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-4);
    text-transform: uppercase;
  }

  .services h2 {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5vw, 4.7rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.075em;
    line-height: 0.94;
    margin: 0;
    max-width: 12ch;
  }

  .services__intro {
    align-self: end;
    display: grid;
    gap: var(--space-5);
  }

  .services__intro p {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    line-height: 1.55;
    margin: 0;
    max-width: 28rem;
  }

  .services__intro :global(.button--quiet) {
    border-color: var(--color-ink);
    justify-self: start;
    opacity: 1;
  }

  .services__intro :global(.button--quiet:hover) {
    background: var(--color-ink);
    color: var(--color-text-inverse);
  }

  .process-list {
    border-top: 2px solid var(--color-ink);
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
  }

  .process-item {
    align-items: start;
    border-bottom: 1px solid var(--color-rule);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    padding: var(--space-5) 0;
  }

  .process-item__number {
    color: var(--color-signal);
    font-size: var(--type-small);
    font-weight: var(--font-weight-bold);
  }

  .process-item__body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .process-item h3 {
    font-size: var(--type-h3);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin: 0;
  }

  .process-item p {
    color: var(--color-text-muted);
    font-size: var(--type-body);
    line-height: 1.5;
    margin: 0;
    max-width: 45rem;
  }

  .process-item__deliverable {
    color: var(--color-text-muted);
    font-size: var(--type-small);
    max-width: 13rem;
    text-align: right;
  }

  @media (min-width: 48rem) {
    .services__heading {
      align-items: end;
      column-gap: var(--space-10);
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    }
  }

  @media (max-width: 47.99rem) {
    .process-item {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .process-item__deliverable {
      grid-column: 2;
      text-align: left;
    }

  }
</style>
