---
type Props = {
  readonly heading?: string
  readonly lede?: string
}

const {
  heading = "Dari brief sampai batch.",
  lede = "Komitmen kami untuk memberikan pengalaman produksi konveksi yang mudah, tepat, dan terpercaya."
} = Astro.props

const features = [
  {
    number: "01",
    title: "MOQ Rendah",
    description: "Fleksibilitas jumlah pemesanan mulai dari 24 pcs untuk memenuhi kebutuhan tim Anda.",
    note: "Mulai 24 pcs"
  },
  {
    number: "02",
    title: "Form Spesifikasi",
    description: "Sistem formulir terstruktur untuk mendetailkan bahan, ukuran, warna, dan bordir secara presisi.",
    note: "Brief terstruktur"
  },
  {
    number: "03",
    title: "Harga Kompetitif",
    description: "Penawaran harga rasional dan transparan sesuai rincian bahan serta spesifikasi yang Anda pilih.",
    note: "Rincian terbuka"
  },
  {
    number: "04",
    title: "Bergaransi",
    description: "Jaminan kualitas produksi dan garansi perbaikan jika terdapat ketidaksesuaian spesifikasi.",
    note: "Kontrol mutu"
  },
  {
    number: "05",
    title: "Pengiriman ke Seluruh Indonesia",
    description: "Jangkauan pengiriman aman dan terpercaya ke seluruh wilayah dan pelosok Indonesia.",
    note: "Jangkauan nasional"
  }
]
---

<section class="services" aria-labelledby="services-title">
  <header class="services__heading">
    <p>Keunggulan & Layanan</p>
    <h2 id="services-title">{heading}</h2>
    <span>{lede}</span>
  </header>

  <div class="features-list">
    {features.map((item) => (
      <article class="feature-item">
        <span class="feature-item__number" aria-hidden="true">{item.number}</span>
        <h3>{item.title}</h3>
        <p class="feature-item__description">{item.description}</p>
        <span class="feature-item__note">{item.note}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .services {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-20) var(--layout-edge);
  }

  .services__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .services__heading p {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
  }

  .services__heading span {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    max-width: 34rem;
  }

  .features-list {
    border-top: 2px solid var(--color-ink);
  }

  .feature-item {
    align-items: start;
    border-bottom: var(--rule-width) solid var(--color-rule);
    display: grid;
    gap: var(--space-2) var(--space-4);
    grid-template-columns: 2.5rem minmax(0, 1fr);
    padding: var(--space-6) 0;
  }

  .feature-item__number {
    color: var(--color-signal);
    font-family: var(--font-display);
    font-size: var(--type-small);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    line-height: 1.5;
  }

  .feature-item h3 {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.3;
    color: var(--color-text);
  }

  .feature-item__description {
    color: var(--color-text-muted);
    font-size: var(--type-body);
    line-height: 1.55;
    margin: 0;
    max-width: 50rem;
    grid-column: 2;
  }

  .feature-item__note {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    grid-column: 2;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .services__heading {
      align-items: start;
      grid-template-columns: 1fr 1.6fr 1fr;
      gap: var(--space-8);
    }

    .feature-item {
      gap: var(--space-2) var(--space-6);
      grid-template-columns: 3rem minmax(0, 1fr) 10rem;
      padding: var(--space-8) var(--space-4);
    }

    .feature-item h3,
    .feature-item__description {
      grid-column: 2;
    }

    .feature-item__note {
      align-self: start;
      grid-column: 3;
      grid-row: 1 / span 2;
      text-align: right;
    }
  }

  @media (min-width: 64rem) {
    .feature-item {
      align-items: start;
      gap: var(--space-6);
      grid-template-columns: 3rem 12rem minmax(0, 1fr) 10.5rem;
    }

    .feature-item h3,
    .feature-item__description,
    .feature-item__note {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
