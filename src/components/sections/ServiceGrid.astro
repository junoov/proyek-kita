---
import { services } from "../../data/company"

type Props = {
  readonly heading?: string
  readonly lede?: string
}

const {
  heading = "Dari brief sampai batch.",
  lede = "Tiga keputusan utama, dengan keluaran yang bisa diperiksa di setiap tahap."
} = Astro.props
---

<section class="services" aria-labelledby="services-title">
  <header class="services__heading">
    <p>Alur kerja / 01—03</p>
    <h2 id="services-title">{heading}</h2>
    <span>{lede}</span>
  </header>

  <ol class="services__list">
    {services.map((service) => (
      <li>
        <span class="service__number">{service.number}</span>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
        <strong>{service.deliverable}</strong>
      </li>
    ))}
  </ol>
</section>

<style>
  .services {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-24) var(--layout-edge);
  }

  .services__heading {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .services__heading p {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: 800;
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--type-h2);
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0;
  }

  .services__heading span {
    color: var(--color-text-muted);
    max-width: 32rem;
  }

  .services__list {
    border-top: 2px solid var(--color-ink);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services__list li {
    align-items: baseline;
    border-bottom: var(--rule-width) solid var(--color-rule);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8) 0;
  }

  .service__number {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: 800;
  }

  h3 {
    font-size: var(--type-h3);
    letter-spacing: -0.035em;
    margin: 0;
  }

  .services__list p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .services__list strong {
    font-size: var(--type-small);
  }

  @media (min-width: 48rem) {
    .services__heading {
      align-items: end;
      grid-template-columns: 0.6fr 1fr 1fr;
    }

    .services__list li {
      grid-template-columns: 0.6fr 1fr 1.4fr 1fr;
    }

  }
</style>
