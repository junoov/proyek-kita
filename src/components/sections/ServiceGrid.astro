---
import { services } from "../../data/company"

type Props = {
  readonly heading?: string
  readonly lede?: string
}

const {
  heading = "Dari kebutuhan tim sampai batch yang siap dipakai.",
  lede = "Tiga fase yang membuat keputusan lebih jelas dan kualitas lebih konsisten."
} = Astro.props
---

<section class="services" aria-labelledby="services-title">
  <div class="services__heading">
    <p class="services__label">Cara kami bekerja</p>
    <h2 id="services-title">{heading}</h2>
    <p>{lede}</p>
  </div>
  <div class="services__grid">
    {services.map((service) => (
      <article class="service">
        <span class="service__number">{service.number}</span>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
        <span class="service__deliverable">{service.deliverable}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .services {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-20) var(--layout-edge);
  }

  .services__heading {
    max-width: 42rem;
  }

  .services__label {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: 720;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-4);
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--type-h2);
    letter-spacing: -0.055em;
    line-height: 1.04;
    margin: 0;
  }

  .services__heading > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    margin: var(--space-5) 0 0;
    max-width: 34rem;
  }

  .services__grid {
    border-top: var(--rule-width) solid var(--color-rule);
    display: grid;
    margin-top: var(--space-12);
  }

  .service {
    border-bottom: var(--rule-width) solid var(--color-rule);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8) 0;
  }

  .service__number {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h3 {
    font-size: var(--type-h3);
    letter-spacing: -0.035em;
    margin: 0;
  }

  .service p {
    color: var(--color-text-muted);
    margin: 0;
    max-width: 27rem;
  }

  .service__deliverable {
    font-size: var(--type-small);
    font-weight: 720;
  }

  @media (min-width: 48rem) {
    .services__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .service {
      border-bottom: 0;
      border-right: var(--rule-width) solid var(--color-rule);
      padding: var(--space-8);
    }

    .service:first-child {
      padding-left: 0;
    }

    .service:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }
</style>
