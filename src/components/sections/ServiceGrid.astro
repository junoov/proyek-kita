---
type Props = {
  readonly heading?: string
  readonly lede?: string
}

const {
  heading = "Komitmen kami untuk memberikan pengalaman produksi konveksi yang mudah, tepat, dan terpercaya.",
  lede = ""
} = Astro.props

const features = [
  {
    title: "MOQ Rendah",
    description: "Fleksibilitas jumlah pemesanan mulai dari 24 pcs untuk memenuhi kebutuhan tim Anda.",
    note: "Mulai 24 pcs",
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
  },
  {
    title: "Form Spesifikasi",
    description: "Sistem formulir terstruktur untuk mendetailkan bahan, ukuran, warna, dan bordir secara presisi.",
    note: "Brief terstruktur",
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>`
  },
  {
    title: "Harga Kompetitif",
    description: "Penawaran harga rasional dan transparan sesuai rincian bahan serta spesifikasi yang Anda pilih.",
    note: "Rincian terbuka",
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.5"/></svg>`
  },
  {
    title: "Bergaransi",
    description: "Jaminan kualitas produksi dan garansi perbaikan jika terdapat ketidaksesuaian spesifikasi.",
    note: "Kontrol mutu",
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`
  },
  {
    title: "Pengiriman ke Seluruh Indonesia",
    description: "Jangkauan pengiriman aman dan terpercaya ke seluruh wilayah dan pelosok Indonesia.",
    note: "Jangkauan nasional",
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`
  }
]
---

<section class="services" aria-labelledby="services-title">
  <header class="services__heading">
    <p>Keunggulan & Layanan</p>
    <h2 id="services-title">{heading}</h2>
    {lede && <span>{lede}</span>}
  </header>

  <div class="features-list">
    {features.map((item) => (
      <article class="feature-item">
        <span class="feature-item__icon" aria-hidden="true" set:html={item.icon} />
        <h3>{item.title}</h3>
        <p class="feature-item__description">{item.description}</p>
        <span class="feature-item__note">{item.note}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .services {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-8) var(--layout-edge) var(--space-20);
  }

  .services__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .services__heading p {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin: 0;
    max-width: 48rem;
  }

  .services__heading span {
    color: var(--color-text-muted);
    font-size: var(--type-lead);
    max-width: 34rem;
  }

  .features-list {
    border-top: 2px solid var(--color-ink);
  }

  .feature-item {
    align-items: start;
    border-bottom: var(--rule-width) solid var(--color-rule);
    display: grid;
    gap: var(--space-2) var(--space-4);
    grid-template-columns: 2.5rem minmax(0, 1fr);
    padding: var(--space-6) 0;
  }

  .feature-item__icon {
    align-items: center;
    align-self: center;
    color: var(--color-signal);
    display: flex;
    grid-column: 1;
    grid-row: 1;
    height: 2.5rem;
    justify-content: center;
    width: 2.5rem;
  }

  .feature-item__icon :global(svg) {
    height: 1.75rem;
    width: 1.75rem;
  }

  .feature-item h3 {
    align-self: center;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: var(--font-weight-bold);
    grid-column: 2;
    grid-row: 1;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0;
  }

  .feature-item__description {
    color: var(--color-text-muted);
    font-size: var(--type-body);
    grid-column: 2;
    grid-row: 2;
    line-height: 1.55;
    margin: 0;
    max-width: 50rem;
  }

  .feature-item__note {
    color: var(--color-signal);
    font-size: var(--type-label);
    font-weight: var(--font-weight-bold);
    grid-column: 2;
    grid-row: 3;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .services__heading {
      align-items: start;
      gap: var(--space-8);
      grid-template-columns: 1fr 2.6fr;
    }

    .feature-item {
      align-items: start;
      gap: var(--space-2) var(--space-6);
      grid-template-columns: 3rem minmax(0, 1fr) 10rem;
      padding: var(--space-8) var(--space-4);
    }

    .feature-item__icon {
      align-self: center;
      grid-column: 1;
      grid-row: 1;
      height: 3rem;
      width: 3rem;
    }

    .feature-item__icon :global(svg) {
      height: 2rem;
      width: 2rem;
    }

    .feature-item h3 {
      align-self: center;
      grid-column: 2;
      grid-row: 1;
    }

    .feature-item__description {
      grid-column: 2;
      grid-row: 2;
    }

    .feature-item__note {
      align-self: center;
      grid-column: 3;
      grid-row: 1 / span 2;
      text-align: right;
    }
  }

  @media (min-width: 64rem) {
    .feature-item {
      align-items: center;
      gap: var(--space-6);
      grid-template-columns: 3rem 13rem minmax(0, 1fr) 10.5rem;
    }

    .feature-item__icon {
      align-self: center;
      grid-column: 1;
      grid-row: 1;
    }

    .feature-item h3 {
      align-self: center;
      grid-column: 2;
      grid-row: 1;
    }

    .feature-item__description {
      align-self: center;
      grid-column: 3;
      grid-row: 1;
    }

    .feature-item__note {
      align-self: center;
      grid-column: 4;
      grid-row: 1;
    }
  }
</style>
