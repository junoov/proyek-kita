---
import { navigation } from "../../data/company"
import BrandMark from "../ui/BrandMark.astro"
import Button from "../ui/Button.astro"

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
---

<header class:list={["site-header", { "site-header--home": currentPath === "/" }]}>
  <a class="skip-link" href="#main">Lewati navigasi</a>
  <div class="site-header__inner">
    <a href="/" class="site-header__brand"><BrandMark /></a>
    <nav class="site-header__nav" aria-label="Navigasi utama">
      {navigation.map((item) => {
        const itemPath = item.href.replace(/\/$/, "") || "/"
        const isActive = itemPath === "/" ? currentPath === "/" : currentPath.startsWith(itemPath)
        return (
          <a
            href={item.href}
            class:list={[{ "is-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        )
      })}
    </nav>
    <div class="site-header__actions">
      <Button href="/kontak" label="Mulai Diskusi" />
    </div>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Navigasi mobile">
        {navigation.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/"
          const isActive = itemPath === "/" ? currentPath === "/" : currentPath.startsWith(itemPath)
          return (
            <a
              href={item.href}
              class:list={[{ "is-active": isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          )
        })}
        <a class="mobile-menu__cta" href="/kontak">Mulai Diskusi</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--header-surface, #a79a8a);
    border-bottom: var(--rule-width) solid var(--header-rule, #6f6257);
    color: var(--header-text, #1a1a1a);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header--home {
    --header-surface: #a79a8a;
    --header-rule: #6f6257;
    --header-text: #1a1a1a;
    --header-signal: #3d352e;
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--layout-max);
    min-height: calc(var(--space-12) + var(--space-6));
    padding: var(--space-3) var(--layout-edge);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      min-height: 4rem;
      padding-block: var(--space-2);
    }
  }

  .site-header__nav,
  .site-header__actions {
    display: none;
  }

  .skip-link {
    background: var(--color-ink);
    color: var(--color-text-inverse);
    left: var(--space-4);
    padding: var(--space-3) var(--space-4);
    position: fixed;
    top: calc(var(--space-16) * -1);
    transition: top var(--transition-micro);
    z-index: 20;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    gap: var(--space-2);
    list-style: none;
    min-height: calc(var(--space-10) + var(--space-1));
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary::after {
    background:
      linear-gradient(currentColor 0 0) center / 100% 2px no-repeat,
      linear-gradient(currentColor 0 0) center / 2px 100% no-repeat;
    color: var(--header-signal, var(--color-signal));
    content: "";
    flex: 0 0 var(--space-3);
    height: var(--space-3);
  }

  .mobile-menu[data-expanded="true"] summary::after,
  .mobile-menu[open]:not([data-expanded]) summary::after {
    background: linear-gradient(currentColor 0 0) center / 100% 2px no-repeat;
  }

  .mobile-menu nav {
    background: #a79a8a;
    display: grid;
    gap: var(--space-1);
    min-width: min(18rem, calc(100vw - var(--space-8)));
    padding: var(--space-3);
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
  }

  .mobile-menu nav a {
    color: #3d352e;
    font-weight: var(--font-weight-medium);
    padding: var(--space-3);
    transition: background-color var(--transition-micro), color var(--transition-micro);
  }

  .mobile-menu nav a:hover {
    background: var(--color-mist);
  }

  .mobile-menu nav a.is-active {
    color: #1a1a1a;
    font-weight: var(--font-weight-semibold);
  }

  .mobile-menu__cta {
    background: var(--color-signal);
    color: var(--color-text-inverse) !important;
    margin-top: var(--space-2);
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: flex;
      gap: var(--space-6);
      align-items: center;
    }

    .site-header__nav a {
      border-bottom: 2px solid transparent;
      color: #3d352e;
      font-size: var(--type-small);
      font-weight: var(--font-weight-medium);
      padding: var(--space-2) 0 calc(var(--space-2) - 1px);
      position: relative;
      transition: border-color var(--transition-micro), color var(--transition-micro);
    }

    .site-header__nav a::after {
      content: none;
    }

    .site-header__nav a:hover {
      border-bottom-color: var(--header-signal, #3d352e);
      color: #1a1a1a;
    }

    .site-header__nav a.is-active {
      border-bottom-color: var(--header-signal, #3d352e);
      color: #1a1a1a;
    }

    .site-header__actions {
      display: block;
    }

    .mobile-menu {
      display: none;
    }
  }

  .site-header--home :global(.button--signal) {
    background: #3d352e;
    border-color: #3d352e;
    color: #f7f3ee;
  }

  .site-header--home :global(.button--signal:hover) {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: #f7f3ee;
  }

  .site-header--home .mobile-menu nav {
    background: #a79a8a;
  }

</style>

<script>
  document.querySelectorAll(".mobile-menu").forEach((menu) => {
    if (!(menu instanceof HTMLDetailsElement)) return

    const summary = menu.querySelector("summary")
    const nav = menu.querySelector("nav")
    if (!summary || !nav) return

    let expanded = menu.open
    let animation: Animation | undefined
    menu.dataset.expanded = String(expanded)

    const setExpanded = (nextExpanded: boolean) => {
      if (nextExpanded === expanded) return

      expanded = nextExpanded
      menu.dataset.expanded = String(expanded)

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        animation?.cancel()
        animation = undefined
        menu.open = expanded
        return
      }

      let from = expanded
        ? { opacity: 0, transform: "translateY(-18px)" }
        : { opacity: 1, transform: "translateY(0)" }

      if (animation) {
        const current = getComputedStyle(nav)
        from = { opacity: Number(current.opacity), transform: current.transform }
        animation.cancel()
      }

      if (expanded) menu.open = true

      const nextAnimation = nav.animate(
        [
          from,
          expanded
            ? { opacity: 1, transform: "translateY(0)" }
            : { opacity: 0, transform: "translateY(-12px)" },
        ],
        {
          duration: expanded ? 280 : 200,
          easing: expanded ? "cubic-bezier(0.16, 1, 0.3, 1)" : "cubic-bezier(0.65, 0, 0.35, 1)",
        },
      )
      animation = nextAnimation

      nextAnimation.addEventListener("finish", () => {
        if (animation !== nextAnimation) return
        if (!expanded) menu.open = false
        animation = undefined
        nextAnimation.cancel()
      }, { once: true })
    }

    summary.addEventListener("click", (event) => {
      event.preventDefault()
      setExpanded(!expanded)
    })

    window.addEventListener("scroll", () => setExpanded(false), { passive: true })
  })
</script>
