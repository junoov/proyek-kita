---
import { navigation } from "../../data/company"
import BrandMark from "../ui/BrandMark.astro"
import Button from "../ui/Button.astro"

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
---

<header class:list={["site-header", { "site-header--home": currentPath === "/" }]}>
  <a class="skip-link" href="#main">Lewati navigasi</a>
  <div class="site-header__inner">
    <a href="/"><BrandMark /></a>
    <nav class="site-header__nav" aria-label="Navigasi utama">
      {navigation.map((item) => {
        const itemPath = item.href.replace(/\/$/, "") || "/"
        const isActive = itemPath === "/" ? currentPath === "/" : currentPath.startsWith(itemPath)
        return (
          <a
            href={item.href}
            class:list={[{ "is-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        )
      })}
    </nav>
    <div class="site-header__actions">
      <Button href="/kontak" label="Mulai Diskusi" />
    </div>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Navigasi mobile">
        {navigation.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/"
          const isActive = itemPath === "/" ? currentPath === "/" : currentPath.startsWith(itemPath)
          return (
            <a
              href={item.href}
              class:list={[{ "is-active": isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          )
        })}
        <a class="mobile-menu__cta" href="/kontak">Mulai Diskusi</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--header-surface, #a79a8a);
    border-bottom: var(--rule-width) solid var(--header-rule, #6f6257);
    color: var(--header-text, #1a1a1a);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header--home {
    --header-surface: #a79a8a;
    --header-rule: #6f6257;
    --header-text: #1a1a1a;
    --header-signal: #3d352e;
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--layout-max);
    min-height: calc(var(--space-12) + var(--space-6));
    padding: var(--space-3) var(--layout-edge);
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      min-height: 4rem;
      padding-block: var(--space-2);
    }
  }

  .site-header__nav,
  .site-header__actions {
    display: none;
  }

  .skip-link {
    background: var(--color-ink);
    color: var(--color-text-inverse);
    left: var(--space-4);
    padding: var(--space-3) var(--space-4);
    position: fixed;
    top: calc(var(--space-16) * -1);
    transition: top var(--transition-micro);
    z-index: 20;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-size: var(--type-small);
    font-weight: var(--font-weight-semibold);
    gap: var(--space-2);
    list-style: none;
    min-height: calc(var(--space-10) + var(--space-1));
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary::after {
    color: var(--header-signal, var(--color-signal));
    content: "+";
    font-size: var(--type-h3);
    font-weight: var(--font-weight-medium);
  }

  .mobile-menu[open] summary::after {
    content: "−";
  }

  .mobile-menu nav {
    background: #a79a8a;
    border: var(--rule-width) solid #6f6257;
    border-radius: 12px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    display: grid;
    gap: var(--space-1);
    min-width: min(18rem, calc(100vw - var(--space-8)));
    padding: var(--space-3);
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
  }

  .mobile-menu nav a {
    border-left: 3px solid transparent;
    color: #3d352e;
    font-weight: var(--font-weight-medium);
    padding: var(--space-3);
    transition: border-color var(--transition-micro), color var(--transition-micro);
  }

  .mobile-menu nav a:hover {
    background: var(--color-mist);
  }

  .mobile-menu nav a.is-active {
    border-left-color: var(--header-signal, #3d352e);
    color: #1a1a1a;
    font-weight: var(--font-weight-semibold);
  }

  .mobile-menu__cta {
    background: var(--color-signal);
    color: var(--color-text-inverse) !important;
    margin-top: var(--space-2);
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: flex;
      gap: var(--space-6);
      align-items: center;
    }

    .site-header__nav a {
      border-bottom: 2px solid transparent;
      color: #3d352e;
      font-size: var(--type-small);
      font-weight: var(--font-weight-medium);
      padding: var(--space-2) 0 calc(var(--space-2) - 1px);
      position: relative;
      transition: border-color var(--transition-micro), color var(--transition-micro);
    }

    .site-header__nav a::after {
      content: none;
    }

    .site-header__nav a:hover {
      border-bottom-color: var(--header-signal, #3d352e);
      color: #1a1a1a;
    }

    .site-header__nav a.is-active {
      border-bottom-color: var(--header-signal, #3d352e);
      color: #1a1a1a;
    }

    .site-header__actions {
      display: block;
    }

    .mobile-menu {
      display: none;
    }
  }

  .site-header--home :global(.button--signal) {
    background: #3d352e;
    border-color: #3d352e;
    color: #f7f3ee;
  }

  .site-header--home :global(.button--signal:hover) {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: #f7f3ee;
  }

  .site-header--home .mobile-menu nav {
    background: #a79a8a;
    border-color: #1a1a1a;
    border-radius: 0;
    border-top: 3px solid #3d352e;
    box-shadow: 0 12px 24px rgba(26, 26, 26, 0.12);
  }
</style>
