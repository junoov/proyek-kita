---
import { navigation } from "../../data/company"
import BrandMark from "../ui/BrandMark.astro"
import Button from "../ui/Button.astro"

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
---

<header class="site-header">
  <a class="skip-link" href="#main">Lewati navigasi</a>
  <div class="site-header__inner">
    <a href="/"><BrandMark /></a>
    <nav class="site-header__nav" aria-label="Navigasi utama">
      {navigation.map((item) => {
        const itemPath = item.href.replace(/\/$/, "") || "/"
        const isActive = itemPath === "/" ? currentPath === "/" : currentPath.startsWith(itemPath)
        return (
          <a
            href={item.href}
            class:list={[{ "is-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        )
      })}
    </nav>
    <div class="site-header__actions">
      <Button href="/kontak" label="Mulai Diskusi" />
    </div>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Navigasi mobile">
        {navigation.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/"
          const isActive = itemPath === "/" ? currentPath === "/" : currentPath.startsWith(itemPath)
          return (
            <a
              href={item.href}
              class:list={[{ "is-active": isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          )
        })}
        <a class="mobile-menu__cta" href="/kontak">Mulai Diskusi</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in oklch, var(--color-canvas) 84%, var(--color-mist));
    border-bottom: var(--rule-width) solid var(--color-rule);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--layout-max);
    min-height: calc(var(--space-12) + var(--space-6));
    padding: var(--space-3) var(--layout-edge);
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      min-height: 4rem;
      padding-block: var(--space-2);
    }
  }

  .site-header__nav,
  .site-header__actions {
    display: none;
  }

  .skip-link {
    background: var(--color-ink);
    color: var(--color-text-inverse);
    left: var(--space-4);
    padding: var(--space-3) var(--space-4);
    position: fixed;
    top: calc(var(--space-16) * -1);
    transition: top var(--transition-micro);
    z-index: 20;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-size: var(--type-small);
    font-weight: 720;
    gap: var(--space-2);
    list-style: none;
    min-height: calc(var(--space-10) + var(--space-1));
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary::after {
    color: var(--color-signal);
    content: "+";
    font-size: var(--type-h3);
    font-weight: 500;
  }

  .mobile-menu[open] summary::after {
    content: "−";
  }

  .mobile-menu nav {
    background: var(--color-canvas);
    border: var(--rule-width) solid var(--color-rule);
    border-radius: 12px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    display: grid;
    gap: var(--space-1);
    min-width: min(18rem, calc(100vw - var(--space-8)));
    padding: var(--space-3);
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
  }

  .mobile-menu nav a {
    color: #342313;
    font-weight: 700;
    padding: var(--space-3);
    border-radius: 6px;
    transition: background var(--transition-micro), color var(--transition-micro);
  }

  .mobile-menu nav a:hover {
    background: var(--color-mist);
  }

  .mobile-menu nav a.is-active {
    color: var(--color-signal);
    background: color-mix(in oklch, var(--color-signal) 12%, transparent);
    font-weight: 700;
  }

  .mobile-menu__cta {
    background: var(--color-signal);
    color: var(--color-text-inverse) !important;
    margin-top: var(--space-2);
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: flex;
      gap: var(--space-6);
      align-items: center;
    }

    .site-header__nav a {
      color: #342313;
      font-size: var(--type-small);
      font-weight: 700;
      position: relative;
      padding-block: var(--space-2);
      transition: color var(--transition-micro);
    }

    .site-header__nav a::after {
      content: "";
      position: absolute;
      bottom: -0.15rem;
      left: 0;
      right: 0;
      height: 2px;
      background-color: var(--color-signal);
      border-radius: 2px;
      opacity: 0;
      transform: scaleX(0);
      transition: transform var(--transition-micro), opacity var(--transition-micro);
    }

    .site-header__nav a:hover {
      color: var(--color-signal);
    }

    .site-header__nav a:hover::after {
      opacity: 0.5;
      transform: scaleX(1);
    }

    .site-header__nav a.is-active {
      color: var(--color-signal);
    }

    .site-header__nav a.is-active::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .site-header__actions {
      display: block;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
