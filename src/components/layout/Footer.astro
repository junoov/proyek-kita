---
import { company, contactChannels, navigation } from "../../data/company"
import BrandMark from "../ui/BrandMark.astro"
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <BrandMark inverted />
      <p>{company.description}</p>
    </div>
    <div class="site-footer__column">
      <span class="site-footer__label">Kunjungi</span>
      <p>{company.address}</p>
      <p>{company.hours}</p>
    </div>
    <div class="site-footer__column">
      <span class="site-footer__label">Hubungi</span>
      {contactChannels.map((channel) => <a href={channel.href}>{channel.value}</a>)}
    </div>
    <div class="site-footer__column">
      <span class="site-footer__label">Navigasi</span>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} {company.legalName}</span>
    <span>Dirancang untuk ritme kerja yang nyata.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: #1a1a1a;
    color: #f7f3ee;
  }

  .site-footer__inner,
  .site-footer__bottom {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding-left: var(--layout-edge);
    padding-right: var(--layout-edge);
  }

  .site-footer__inner {
    display: grid;
    column-gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-6);
    padding-bottom: var(--space-6);
    padding-top: var(--space-8);
  }

  .site-footer__identity p,
  .site-footer__column p,
  .site-footer__column a {
    color: #f7f3ee;
    font-size: var(--type-small);
    line-height: 1.5;
    margin: 0;
    opacity: 0.76;
  }

  .site-footer__identity {
    grid-column: 1 / -1;
  }

  .site-footer__identity p {
    margin-top: var(--space-2);
    max-width: 26rem;
    font-size: 0.85rem;
  }

  .site-footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-1.5);
    min-width: 0;
  }

  .site-footer__column a {
    font-size: 0.85rem;
    overflow-wrap: anywhere;
    transition: opacity var(--transition-micro);
  }

  .site-footer__column p {
    font-size: 0.85rem;
  }

  .site-footer__column a:hover {
    opacity: 1;
  }

  .site-footer__label {
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-1);
    text-transform: uppercase;
    color: #d8cfc4;
  }

  .site-footer__bottom {
    border-top: var(--rule-width) solid color-mix(in oklch, var(--color-text-inverse) 15%, transparent);
    color: var(--color-text-inverse);
    display: flex;
    flex-direction: row;
    font-size: 0.8rem;
    gap: var(--space-2);
    opacity: 0.7;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    padding-top: var(--space-4);
  }

  .site-footer__bottom span:last-child {
    display: none;
  }

  @media (min-width: 30rem) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      column-gap: var(--space-8);
      grid-template-columns: 1.8fr repeat(3, 1fr);
      padding-bottom: var(--space-8);
      padding-top: var(--space-10);
      row-gap: var(--space-6);
    }

    .site-footer__identity {
      grid-column: auto;
    }

    .site-footer__bottom {
      padding-bottom: var(--space-4);
      padding-top: var(--space-4);
    }

    .site-footer__bottom span:last-child {
      display: inline;
    }
  }
</style>
